registerTemplate("appointment.GanttPopover", `/appointment/static/src/views/gantt/gantt_popover.xml`, `<t t-name="appointment.GanttPopover" t-inherit="web_gantt.GanttPopover" t-inherit-mode="primary" xml:space="preserve">
