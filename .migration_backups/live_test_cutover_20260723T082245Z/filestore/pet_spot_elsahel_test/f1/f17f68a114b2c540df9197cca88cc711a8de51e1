            <span class="fs-4">View in Error:</span>
            <table>
                <thead>
                    <th>IDs</th>
                    <th>Name</th>
                    <th>Model</th>
                    <th>Parent View (inherit_id)</th>
                </thead>
                <tbody>
                    <td>
                        <t t-foreach="viewError.resIds" t-as="resId" t-key="resId">
                            <a t-att-href="urlFor('ir.ui.view', resId)" t-on-click.synthetic.prevent="() =&gt; this.openRecord(viewError.viewModel, resId)" t-esc="resId"/>
                            <span class="me-2">,</span>
