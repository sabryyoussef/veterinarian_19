registerTemplate("knowledge.ArticleTemplatePickerDialog", `/knowledge/static/src/components/article_template_picker_dialog/article_template_picker_dialog.xml`, `<t t-name="knowledge.ArticleTemplatePickerDialog" xml:space="preserve">
