registerTemplate("crm.ColumnProgress", `/crm/static/src/views/crm_kanban/crm_column_progress.xml`, `<t t-name="crm.ColumnProgress" t-inherit="mail.RottingColumnProgress" t-inherit-mode="primary" xml:space="preserve">
