                            <b t-out="slot['start_hour']"/>
                            <t t-if="slot['end_hour']">
                                to <t t-out="slot['end_hour']"/>
                            </t>
                        </button>
                </div>
                <t t-if="!slot['is_long_duration']" t-set="small_slot_counter" t-value="small_slot_counter + 1"/>
            </t>
        </div>
    </t>

`);
