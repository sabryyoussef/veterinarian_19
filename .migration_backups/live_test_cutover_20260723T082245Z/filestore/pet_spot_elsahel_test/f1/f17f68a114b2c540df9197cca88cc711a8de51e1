registerTemplate("knowledge.PermissionPanel", `/knowledge/static/src/components/permission_panel/permission_panel.xml`, `<t t-name="knowledge.PermissionPanel" xml:space="preserve">
        <div class="o_knowledge_permission_panel px-3 py-2 gap-2 overflow-y-auto">
            <div class="d-flex align-items-center py-1 knowledge_restriction_message" t-if="data.is_desynchronized and state.isArticleLoaded">
                <i class="fa fa-fw fa-shield fa-2x mx-1"/>
