                            <div class="row">
                                <div class="col-lg-10">
                                    <h3>Import contacts</h3>
                                    <p>Import customers or suppliers (partners) and their contacts using a
                                        <a class="fw-bold" href="/base/static/xls/contacts_import_template.xlsx" aria-label="Download" title="Download">
                                            template.
                                        </a>
                                    </p>
                                    <button type="button" class="btn btn-primary" t-on-click="() =&gt; this._importAccountGuideAction('account_base_import.action_partner_import')">Import Contacts</button>
                                </div>
                                <div class="col-lg-2 border-start"/>
                            </div>
                        </li>
                        <li class="col-lg-6 pt-4">
