                        <tr>
                            <th rowspan="2" class="text-center align-middle">
                                <t t-esc="model.metaData.dateStartString"/>
                            </th>
                            <th rowspan="2" class="text-center align-middle">
                                <t t-esc="model.metaData.measures[model.metaData.measure].string"/>
