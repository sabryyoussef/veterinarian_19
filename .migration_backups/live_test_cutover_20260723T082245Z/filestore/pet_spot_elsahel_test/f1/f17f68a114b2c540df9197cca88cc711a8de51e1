registerTemplate("account_base_import.accountImportTemplate", `/account_base_import/static/src/xml/account_import.xml`, `<t t-name="account_base_import.accountImportTemplate" xml:space="preserve">
        <ControlPanel/>
        <div class="container text-justify overflow-auto h-100">
            <div class="d-flex flex-column my-5 pt-4">
                <div class="title">
                    <h1>
                        Accounting Import Options
                    </h1>
                    <p>
                        Use predefined format to import your data faster.
                    </p>
                </div>
                <t t-if="countryCode === 'BE'">
                    <div class="winbooks-import pt-4">
                        <h2 class="text-primary">
                            Winbooks
                        </h2>
                        <p>
                            Winbooks is an old school Belgian accounting software acquired by Exact.
                            Use the
                            <a class="fw-bold" href="#" t-on-click.prevent="() =&gt; this._openModuleInstallation('account_winbooks_import')">
                                Account Winbooks Import module
                            </a>
                            to import a Winbooks full back-up (Maintenance &gt; Backup) to get the chart of accounts, contacts, taxes, history of journal entries, and documents.
                            Support versions: Winbooks Desktop 5.50, 6, 7, 8.
                        </p>
