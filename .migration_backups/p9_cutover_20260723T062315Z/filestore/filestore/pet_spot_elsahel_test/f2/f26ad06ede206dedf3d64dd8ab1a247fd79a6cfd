                            <span class="me-2">,</span>
                        </t>
                    </td>
                </tbody>
            </table>
        </div>
        <div>
            <button class="btn btn-primary" t-on-click="() =&gt; state.showTrace = !state.showTrace">Show Traceback</button>
        </div>
        <div t-if="state.showTrace">
