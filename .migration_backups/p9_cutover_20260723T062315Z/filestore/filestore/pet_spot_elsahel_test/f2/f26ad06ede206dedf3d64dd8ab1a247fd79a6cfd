                        <circle class="o_crm_tooltip_wheel_bg_circle" cx="30" cy="30" r="25" fill="none" stroke-width="4"/>
                        <circle cx="30" cy="30" r="25" fill="none" stroke-width="4" t-att-stroke-dasharray="props.dashArrayVals"/>
                    </svg>
                    <div class="position-absolute d-flex">
                        <span class="m-auto fw-bolder">
                            <t t-out="props.probability"/>%
