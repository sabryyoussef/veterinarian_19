                        </span>
                    </p>
                </div>
                <t t-if="canRevokeEntry(ruleId)">
                    <div class="o_web_studio_approval_button">
                        <button class="btn btn-secondary btn-sm btn-block o_web_approval_cancel" title="Revoke" t-on-click="(ev) =&gt; this.cancelApproval(rule.id)" t-att-disabled="state.syncing || approval.inStudio">
                            <i class="fa fa-fw fa-undo"/>
                        </button>
                    </div>
                </t>
            </div>
        </div>
    </div>
</t>

`);
