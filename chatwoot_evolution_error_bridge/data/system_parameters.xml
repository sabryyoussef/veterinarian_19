<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Default system parameters for Chatwoot Bridge -->
        <record id="param_chatwoot_bridge_token" model="ir.config_parameter">
            <field name="key">chatwoot_bridge.token</field>
            <field name="value">CHANGE_ME_TO_SECURE_TOKEN</field>
        </record>

        <record id="param_chatwoot_bridge_cors" model="ir.config_parameter">
            <field name="key">chatwoot_bridge.cors_origins</field>
            <field name="value">*</field>
        </record>
    </data>
</odoo>
