<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_config_settings_chatwoot" model="ir.ui.view">
        <field name="name">res.config.settings.chatwoot.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Chatwoot Bridge" name="chatwoot_evolution_error_bridge">
                    <block title="Chatwoot / Evolution WhatsApp Bridge">
                        <setting string="Bridge API Token"
                                 help="Token for X-Bridge-Token header (same as Integration Bridge master token).">
                            <field name="chatwoot_bridge_token" password="True"/>
                        </setting>
                        <setting string="CORS Origins"
                                 help="Comma-separated origins or * for all.">
                            <field name="chatwoot_bridge_cors_origins"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
