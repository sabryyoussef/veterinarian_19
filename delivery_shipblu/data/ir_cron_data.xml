<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_shipblu_import_orders" model="ir.cron">
        <field name="name">ShipBlu: Import delivery orders</field>
        <field name="model_id" ref="petspot_shipblu_base.model_shipblu_backend"/>
        <field name="state">code</field>
        <field name="code">model.cron_import_orders()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
    <record id="ir_cron_shipblu_sync_tracking" model="ir.cron">
        <field name="name">ShipBlu: Sync tracking</field>
        <field name="model_id" ref="petspot_shipblu_base.model_shipblu_backend"/>
        <field name="state">code</field>
        <field name="code">model.cron_sync_tracking()</field>
        <field name="interval_number">30</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
    <!-- Dangerous / optional jobs — disabled by default -->
    <record id="ir_cron_shipblu_sync_merchant" model="ir.cron">
        <field name="name">ShipBlu: Sync merchant / wallet</field>
        <field name="model_id" ref="petspot_shipblu_base.model_shipblu_backend"/>
        <field name="state">code</field>
        <field name="code">model.search([('active','=',True)]).action_sync_merchant_profile()</field>
        <field name="interval_number">6</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="False"/>
    </record>
    <record id="ir_cron_shipblu_detect_delayed" model="ir.cron">
        <field name="name">ShipBlu: Detect delayed shipments</field>
        <field name="model_id" ref="model_shipblu_shipment"/>
        <field name="state">code</field>
        <field name="code">model.search([])._compute_sla_overdue()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="False"/>
    </record>
    <record id="ir_cron_shipblu_monthly_volume" model="ir.cron">
        <field name="name">ShipBlu: Recalc monthly volume displays</field>
        <field name="model_id" ref="petspot_shipblu_base.model_shipblu_backend"/>
        <field name="state">code</field>
        <field name="code">model.search([('active','=',True)])._compute_monthly_volume()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="False"/>
    </record>
</odoo>
