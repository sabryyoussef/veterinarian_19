<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_delivery_carrier_form_shipblu" model="ir.ui.view">
        <field name="name">delivery.carrier.form.shipblu</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="ShipBlu" invisible="delivery_type != 'shipblu'">
                    <field name="shipblu_backend_id"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
