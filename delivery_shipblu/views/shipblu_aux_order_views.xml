<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_shipblu_return_tree" model="ir.ui.view">
        <field name="name">shipblu.return.order.list</field>
        <field name="model">shipblu.return.order</field>
        <field name="arch" type="xml">
            <list create="0"><field name="name"/><field name="tracking_number"/><field name="raw_status"/><field name="shipblu_return_id"/></list>
        </field>
    </record>
    <record id="action_shipblu_return" model="ir.actions.act_window">
        <field name="name">Returns</field>
        <field name="res_model">shipblu.return.order</field>
        <field name="view_mode">list,form</field>
    </record>
