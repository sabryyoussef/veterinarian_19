<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_shipblu_backend_form_delivery" model="ir.ui.view">
        <field name="name">shipblu.backend.form.delivery</field>
        <field name="model">shipblu.backend</field>
        <field name="inherit_id" ref="petspot_shipblu_base.view_shipblu_backend_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_test_connection']" position="after">
                <button name="action_import_shipblu_orders" type="object" string="Import ShipBlu Orders"
                        groups="petspot_shipblu_base.group_shipblu_user"/>
                <button name="action_sync_tracking" type="object" string="Sync Tracking"
                        groups="petspot_shipblu_base.group_shipblu_user"/>
                <button name="action_sync_coverage" type="object" string="Sync Coverage"
                        groups="petspot_shipblu_base.group_shipblu_manager"/>
                <button name="action_import_aux_orders" type="object" string="Import Returns/Exchanges/COD"
                        groups="petspot_shipblu_base.group_shipblu_manager"/>
            </xpath>
        </field>
    </record>
</odoo>
