<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_shipblu" model="ir.ui.view">
        <field name="name">stock.picking.form.shipblu</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_shipblu_create_shipment" type="object"
                        string="Create ShipBlu Shipment"
                        class="btn-primary"
                        groups="petspot_shipblu_base.group_shipblu_user"
                        invisible="picking_type_code != 'outgoing' or shipblu_order_id or state == 'cancel'"/>
                <button name="action_shipblu_refresh_status" type="object"
                        string="Refresh ShipBlu Status"
                        groups="petspot_shipblu_base.group_shipblu_user"
                        invisible="not shipblu_order_id"/>
                <button name="action_shipblu_request_pickup" type="object"
                        string="Request ShipBlu Pickup"
                        groups="petspot_shipblu_base.group_shipblu_user"
                        invisible="not shipblu_order_id"/>
            </xpath>
            <xpath expr="//page[@name='extra']" position="after">
                <page string="ShipBlu" name="shipblu_shipping"
                      invisible="picking_type_code != 'outgoing'">
                    <group>
                        <group>
                            <field name="shipblu_shipment_owner"/>
                            <field name="shipblu_order_id"/>
                            <field name="shipblu_business_reference"/>
                            <field name="shipblu_tracking_url" widget="url"/>
                        </group>
                        <group>
                            <field name="shipblu_raw_status"/>
                            <field name="shipblu_normalized_status"/>
                            <field name="shipblu_shipment_id"/>
                        </group>
                    </group>
                    <field name="shipblu_shipment_ids">
                        <list>
                            <field name="name"/>
                            <field name="tracking_number"/>
                            <field name="normalized_status"/>
                            <field name="state"/>
                            <field name="cod_amount"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
