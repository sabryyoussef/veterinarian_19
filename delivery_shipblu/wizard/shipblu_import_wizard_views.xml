<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_shipblu_import_wizard_form" model="ir.ui.view">
        <field name="name">shipblu.import.wizard.form</field>
        <field name="model">shipblu.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import ShipBlu Orders">
                <group>
                    <field name="backend_id"/>
                    <field name="sync_coverage"/>
                    <field name="sync_aux"/>
                </group>
                <group>
                    <field name="result_message" nolabel="1" colspan="2"/>
                </group>
                <footer>
                    <button name="action_run" type="object" string="Run Import" class="btn-primary"/>
                    <button string="Close" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_shipblu_import_wizard" model="ir.actions.act_window">
        <field name="name">Import ShipBlu Orders</field>
        <field name="res_model">shipblu.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
