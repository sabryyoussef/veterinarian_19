<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dev_work_approval_list" model="ir.ui.view">
        <field name="name">dev.work.approval.list</field>
        <field name="model">dev.work.approval</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="plan_id"/>
                <field name="decision" widget="badge"/>
                <field name="approver_id"/>
                <field name="decided_at"/>
                <field name="plan_hash"/>
            </list>
        </field>
    </record>

    <record id="view_dev_work_approval_form" model="ir.ui.view">
        <field name="name">dev.work.approval.form</field>
        <field name="model">dev.work.approval</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        Approvals are immutable. To approve a plan, open DH Plan (or a plan
                        awaiting approval) and use Approve Exact Hash. If the work item is
                        not in Awaiting Plan Approval, complete Plan submission first.
                    </div>
                    <group>
                        <group>
                            <field name="work_item_id"/>
                            <field name="plan_id"/>
                            <field name="plan_revision"/>
                            <field name="plan_hash"/>
                        </group>
                        <group>
                            <field name="decision"/>
                            <field name="approver_id"/>
                            <field name="decided_at"/>
                            <field name="policy_version"/>
                        </group>
                    </group>
                    <field name="comment"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dev_work_plan_form_approval" model="ir.ui.view">
        <field name="name">dev.work.plan.form.approval</field>
        <field name="model">dev.work.plan</field>
        <field name="inherit_id" ref="devhub_plan.view_dev_work_plan_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_submit_for_approval']" position="after">
                <button name="action_approve_exact" type="object" string="Approve Exact Hash" class="btn-primary" groups="devhub_core.group_dev_hub_approver" invisible="status != 'awaiting_approval'"/>
                <button name="action_reject" type="object" string="Reject" groups="devhub_core.group_dev_hub_approver" invisible="status != 'awaiting_approval'"/>
            </xpath>
        </field>
    </record>

    <record id="view_dev_work_item_form_plan_approval" model="ir.ui.view">
        <field name="name">dev.work.item.form.plan.approval</field>
        <field name="model">dev.work.item</field>
        <field name="inherit_id" ref="devhub_plan.view_dev_work_item_form_plan"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='plan_ids']/form/header/button[@name='action_submit_for_approval']" position="after">
                <button name="action_approve_exact" type="object" string="Approve Exact Hash" class="btn-primary" groups="devhub_core.group_dev_hub_approver" invisible="status != 'awaiting_approval'"/>
            </xpath>
        </field>
    </record>


    <record id="view_dev_work_plan_form_approval_ids" model="ir.ui.view">
        <field name="name">dev.work.plan.form.approval.ids</field>
        <field name="model">dev.work.plan</field>
        <field name="inherit_id" ref="devhub_plan.view_dev_work_plan_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Approvals">
                    <field name="approval_ids" nolabel="1">
                        <list create="0" edit="0" delete="0">
                            <field name="decision"/>
                            <field name="approver_id"/>
                            <field name="decided_at"/>
                            <field name="plan_hash"/>
                        </list>
                    </field>
                </group>
            </xpath>
        </field>
    </record>

    <record id="action_dev_work_approval" model="ir.actions.act_window">
        <field name="name">Plan Approvals</field>
        <field name="res_model">dev.work.approval</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_devhub_approval_root"
              name="DH Approval"
              sequence="89"
              web_icon="devhub_approval,static/description/icon.png"
              groups="devhub_core.group_dev_hub_user"/>

    <menuitem id="menu_devhub_approval_records"
              name="Plan Approvals"
              parent="menu_devhub_approval_root"
              action="action_dev_work_approval"
              sequence="10"
              groups="devhub_core.group_dev_hub_user"/>

    <menuitem id="menu_devhub_approval_plans"
              name="Plans Awaiting Approval"
              parent="menu_devhub_approval_root"
              action="devhub_plan.action_dev_work_plan"
              sequence="20"
              groups="devhub_core.group_dev_hub_approver"/>

</odoo>

