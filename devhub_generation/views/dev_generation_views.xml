<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dev_project_generation_form" model="ir.ui.view">
        <field name="name">dev.project.generation.form</field>
        <field name="model">dev.project</field>
        <field name="inherit_id" ref="devhub_core.view_dev_project_form"/>
        <field name="arch" type="xml">
            <field name="github_reference" position="after">
                <field name="generation_policy"/>
                <field name="generation_provider" invisible="generation_policy != 'automatic'"/>
                <field name="analysis_source_mode"/>
            </field>
        </field>
    </record>
</odoo>
