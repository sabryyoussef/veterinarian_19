<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_dev_git_commit_record" model="ir.actions.act_window">
        <field name="name">Commit Records</field>
        <field name="res_model">dev.git.commit.record</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_dev_git_push_record" model="ir.actions.act_window">
        <field name="name">Push Records</field>
        <field name="res_model">dev.git.push.record</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_dev_git_commit_approval" model="ir.actions.act_window">
        <field name="name">Commit Approvals</field>
        <field name="res_model">dev.git.commit.approval</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_devhub_git_root"
              name="DH Git"
              sequence="92"
              web_icon="devhub_git,static/description/icon.png"
              groups="devhub_core.group_dev_hub_user"/>

    <menuitem id="menu_devhub_git_commits"
              name="Commit Records"
              parent="menu_devhub_git_root"
              action="action_dev_git_commit_record"
              sequence="10"
              groups="devhub_core.group_dev_hub_user"/>

    <menuitem id="menu_devhub_git_commit_approvals"
              name="Commit Approvals"
              parent="menu_devhub_git_root"
              action="action_dev_git_commit_approval"
              sequence="15"
              groups="devhub_core.group_dev_hub_user"/>

    <menuitem id="menu_devhub_git_pushes"
              name="Push Records"
              parent="menu_devhub_git_root"
              action="action_dev_git_push_record"
              sequence="20"
              groups="devhub_core.group_dev_hub_user"/>
</odoo>
