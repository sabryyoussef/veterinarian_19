<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_dev_git_pr_record" model="ir.actions.act_window">
        <field name="name">PR Records</field>
        <field name="res_model">dev.git.pr.record</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_dev_git_merge_record" model="ir.actions.act_window">
        <field name="name">Merge Records</field>
        <field name="res_model">dev.git.merge.record</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_dev_git_merge_approval" model="ir.actions.act_window">
        <field name="name">Merge Approvals</field>
        <field name="res_model">dev.git.merge.approval</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_devhub_github_root"
              name="DH GitHub"
              sequence="93"
              web_icon="devhub_github,static/description/icon.png"
              groups="devhub_core.group_dev_hub_user"/>

    <menuitem id="menu_devhub_github_prs"
              name="PR Records"
              parent="menu_devhub_github_root"
              action="action_dev_git_pr_record"
              sequence="10"
              groups="devhub_core.group_dev_hub_user"/>

    <menuitem id="menu_devhub_github_merges"
              name="Merge Records"
              parent="menu_devhub_github_root"
              action="action_dev_git_merge_record"
              sequence="20"
              groups="devhub_core.group_dev_hub_user"/>

    <menuitem id="menu_devhub_github_merge_approvals"
              name="Merge Approvals"
              parent="menu_devhub_github_root"
              action="action_dev_git_merge_approval"
              sequence="25"
              groups="devhub_core.group_dev_hub_user"/>

    <menuitem id="menu_devhub_github_apps"
              name="GitHub Apps"
              parent="menu_devhub_github_root"
              action="action_dev_github_app_installation"
              sequence="40"
              groups="devhub_core.group_dev_hub_manager"/>
</odoo>
