<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dev_external_outbox_service_list" model="ir.ui.view">
        <field name="name">dev.external.outbox.service.list</field>
        <field name="model">dev.external.outbox</field>
        <field name="inherit_id" ref="devhub_work.view_dev_external_outbox_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='attempt_count']" position="after">
                <field name="correlation_id"/>
                <field name="lease_consumer_ref" optional="hide"/>
                <field name="lease_expires_at" optional="hide"/>
            </xpath>
        </field>
    </record>
    <record id="view_dev_external_outbox_service_form" model="ir.ui.view">
        <field name="name">dev.external.outbox.service.form</field>
        <field name="model">dev.external.outbox</field>
        <field name="inherit_id" ref="devhub_work.view_dev_external_outbox_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='idempotency_key']" position="after">
                <field name="correlation_id"/>
                <field name="communication_id"/>
            </xpath>
            <xpath expr="//field[@name='attempt_count']" position="after">
                <field name="max_attempts"/>
                <field name="lease_owner_id"/>
                <field name="lease_consumer_ref"/>
                <field name="leased_at"/>
                <field name="lease_expires_at"/>
                <field name="processing_at"/>
            </xpath>
        </field>
    </record>
</odoo>
