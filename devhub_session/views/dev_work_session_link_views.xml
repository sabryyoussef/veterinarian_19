<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dev_work_item_session_form" model="ir.ui.view">
        <field name="name">dev.work.item.session.form</field>
        <field name="model">dev.work.item</field>
        <field name="inherit_id" ref="devhub_work.view_dev_work_item_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='page_development']/group" position="after">
                <field name="session_ids">
                    <list>
                        <field name="name"/>
                        <field name="state" widget="badge"/>
                        <field name="client_id"/>
                        <field name="machine_id"/>
                        <field name="git_branch_snapshot"/>
                        <field name="started_at"/>
                        <field name="completed_at"/>
                    </list>
                </field>
            </xpath>
        </field>
    </record>
</odoo>
