<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="icp_allow_fixture_ai" model="ir.config_parameter">
        <field name="key">devhub_whatsapp.allow_fixture_ai</field>
        <field name="value">False</field>
    </record>
    <record id="icp_unique_candidate_min_score" model="ir.config_parameter">
        <field name="key">devhub_whatsapp.unique_candidate_min_score</field>
        <field name="value">0.70</field>
    </record>
    <record id="icp_strong_candidate_min_score" model="ir.config_parameter">
        <field name="key">devhub_whatsapp.strong_candidate_min_score</field>
        <field name="value">0.85</field>
    </record>
    <record id="icp_candidate_score_margin" model="ir.config_parameter">
        <field name="key">devhub_whatsapp.candidate_score_margin</field>
        <field name="value">0.20</field>
    </record>
    <record id="icp_project_relevance_min_confidence" model="ir.config_parameter">
        <field name="key">devhub_whatsapp.project_relevance_min_confidence</field>
        <field name="value">0.50</field>
    </record>
    <record id="icp_media_dominant_ratio" model="ir.config_parameter">
        <field name="key">devhub_whatsapp.media_dominant_ratio</field>
        <field name="value">0.40</field>
    </record>
    <record id="icp_analysis_review_only" model="ir.config_parameter">
        <field name="key">devhub_whatsapp.analysis_review_only</field>
        <field name="value">False</field>
    </record>
</odoo>
