# Managed by: server setup/ssh/install-ssh-config.sh

Include ~/.ssh/config.d/phone

# Managed by: server setup/ssh/install-ssh-config.sh
# Source: ssh/config.d/*.conf — edit fragments, then re-run this script
# Inactive/failed: ssh/inactive/*.disabled — see ssh/TEST-RESULTS.md
# Cursor: .vscode/settings.json -> ssh/config

# =============================================================================
# Global defaults (all hosts unless overridden)
# =============================================================================
Host * !master-ts
  ServerAliveInterval 60
  ServerAliveCountMax 3
  TCPKeepAlive yes
  ForwardAgent no
  AddKeysToAgent yes
  StrictHostKeyChecking accept-new

# =============================================================================
# 4-machine cluster — TESTED OK on master (2026-06-25)
# Run: python3 ssh/test-all-hosts.py
# Failed / inactive hosts: ssh/inactive/*.disabled
# =============================================================================

Host master sabry-z620
  HostName 192.168.100.66
  User sabry
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes
  ServerAliveInterval 30
  ConnectTimeout 10

Host master-ts
  HostName 100.76.217.35
  User sabry
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes
  StrictHostKeyChecking yes
  UserKnownHostsFile ~/.ssh/known_hosts
  HostKeyAlias master-ts
  CheckHostIP yes
  ServerAliveInterval 30
  ConnectTimeout 15

