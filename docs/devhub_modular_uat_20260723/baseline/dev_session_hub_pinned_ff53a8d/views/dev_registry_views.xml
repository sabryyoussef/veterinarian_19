<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dev_machine_list" model="ir.ui.view">
        <field name="name">dev.machine.list</field>
        <field name="model">dev.machine</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="hostname"/>
                <field name="tailscale_name"/>
                <field name="tailscale_destination_verified"/>
                <field name="ssh_alias"/>
                <field name="role"/>
                <field name="trust_zone"/>
                <field name="production"/>
                <field name="last_reachability_status"/>
                <field name="last_checked_at"/>
            </list>
        </field>
    </record>

    <record id="view_dev_machine_form" model="ir.ui.view">
        <field name="name">dev.machine.form</field>
        <field name="model">dev.machine</field>
        <field name="arch" type="xml">
            <form string="Development Machine">
                <header>
                    <button name="action_verify_tailscale_destination"
                            type="object"
                            string="Verify Tailscale Destination"
                            class="btn-primary"
                            groups="dev_session_hub.group_dev_hub_manager"
                            invisible="production or not active"
                            confirm="Run active Tailscale and SSH host-key verification for this registered destination?"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="stable_uuid" readonly="1"/>
                            <field name="hostname"/>
                            <field name="ssh_alias"/>
                            <field name="verification_ssh_user"/>
                            <field name="role"/>
                        </group>
                        <group>
                            <field name="tailscale_name"/>
                            <field name="tailscale_ip_reference"/>
                            <field name="tailscale_destination_verified" readonly="1"/>
                            <field name="tailscale_verified_at" readonly="1"/>
                            <field name="pinned_host_key_fingerprint"/>
                            <field name="os_name"/>
                            <field name="architecture"/>
                            <field name="trust_zone"/>
                        </group>
                    </group>
                    <group>
                        <field name="production"/>
                        <field name="active"/>
                        <field name="last_reachability_status" readonly="1"/>
                        <field name="last_checked_at" readonly="1"/>
                    </group>
                    <group string="Strict Launch Allowlist">
                        <field name="allowed_path_prefixes" placeholder="/absolute/development/path"/>
                    </group>
                    <notebook>
                        <page string="Verification Audit" groups="dev_session_hub.group_dev_hub_manager">
                            <field name="verification_event_ids" readonly="1">
                                <list>
                                    <field name="timestamp"/>
                                    <field name="success"/>
                                    <field name="reason_code"/>
                                    <field name="destination_ref"/>
                                    <field name="fingerprint_ref"/>
                                    <field name="actor_id"/>
                                    <field name="dry_run"/>
                                    <field name="correlation_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dev_machine" model="ir.actions.act_window">
        <field name="name">Machines</field>
        <field name="res_model">dev.machine</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_dev_client_list" model="ir.ui.view">
        <field name="name">dev.client.list</field>
        <field name="model">dev.client</field>
        <field name="arch" type="xml">
            <list decoration-warning="compliance_status in ('unresolved', 'warning')" decoration-danger="compliance_status == 'noncompliant'">
                <field name="name"/>
                <field name="user_name"/>
                <field name="os_name"/>
                <field name="architecture"/>
                <field name="cursor_version"/>
                <field name="helper_version"/>
                <field name="baseline_revision"/>
                <field name="compliance_status"/>
                <field name="last_seen_at"/>
            </list>
        </field>
    </record>

    <record id="view_dev_client_form" model="ir.ui.view">
        <field name="name">dev.client.form</field>
        <field name="model">dev.client</field>
        <field name="arch" type="xml">
            <form string="Development Client">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="user_name"/>
                            <field name="os_name"/>
                            <field name="architecture"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="cursor_version"/>
                            <field name="cursor_agent_version"/>
                            <field name="helper_version"/>
                            <field name="baseline_revision"/>
                            <field name="compliance_status"/>
                            <field name="last_seen_at"/>
                        </group>
                    </group>
                    <group>
                        <field name="public_key_fingerprint_reference"/>
                        <field name="compliance_note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dev_client" model="ir.actions.act_window">
        <field name="name">Development Clients</field>
        <field name="res_model">dev.client</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_dev_project_list" model="ir.ui.view">
        <field name="name">dev.project.list</field>
        <field name="model">dev.project</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="owner_id"/>
                <field name="member_ids" widget="many2many_tags"/>
                <field name="default_repository_id"/>
                <field name="default_environment_id"/>
                <field name="openproject_reference"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_dev_project_form" model="ir.ui.view">
        <field name="name">dev.project.form</field>
        <field name="model">dev.project</field>
        <field name="arch" type="xml">
            <form string="Development Project">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="owner_id"/>
                            <field name="member_ids" widget="many2many_tags"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="default_repository_id"/>
                            <field name="default_environment_id"/>
                            <field name="analysis_runtime_id"/>
                            <field name="openproject_reference"/>
                            <field name="github_reference"/>
                            <field name="generation_policy"/>
                            <field name="generation_provider" invisible="generation_policy != 'automatic'"/>
                            <button name="action_open_test_environment_url"
                                    type="object"
                                    string="Open Test URL"
                                    class="btn-secondary"
                                    invisible="not default_environment_id"/>
                            <button name="action_open_default_repository_path"
                                    type="object"
                                    string="Show Repository Path"
                                    class="btn-secondary"
                                    invisible="not default_repository_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Guardrails">
                            <field name="production_policy"/>
                            <field name="agent_instruction_summary"/>
                        </page>
                        <page string="Repositories">
                            <field name="repository_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="working_directory"/>
                                    <field name="current_branch_cache"/>
                                    <field name="head_cache"/>
                                </list>
                            </field>
                        </page>
                        <page string="Environments">
                            <field name="environment_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="environment_type"/>
                                    <field name="environment_role"/>
                                    <field name="runtime_id"/>
                                    <field name="machine_id"/>
                                    <field name="database_identifier"/>
                                    <field name="port"/>
                                    <field name="url"/>
                                </list>
                            </field>
                        </page>
                        <page string="Odoo Project &amp; Tasks">
                            <div class="alert alert-info" role="alert" invisible="has_openproject_mapping">
                                No OpenProject map is linked. Add maps below (managers) to show Odoo tasks.
                            </div>
                            <group invisible="not has_openproject_mapping">
                                <group>
                                    <field name="primary_odoo_project_id" readonly="1"/>
                                    <field name="odoo_project_ids" widget="many2many_tags" readonly="1"/>
                                </group>
                                <group>
                                    <button name="action_open_primary_odoo_project"
                                            type="object"
                                            string="Open Odoo Project"
                                            class="btn-secondary"
                                            invisible="not has_openproject_mapping"/>
                                </group>
                            </group>
                            <group string="OpenProject Maps" groups="dev_session_hub.group_dev_hub_manager">
                                <field name="openproject_map_ids" widget="many2many_tags" options="{'no_create': True}"/>
                            </group>
                            <field name="has_openproject_mapping" invisible="1"/>
                            <field name="mapped_task_ids" readonly="1" context="{'dev_project_id': id}">
                                <list>
                                    <field name="id" string="Task ID"/>
                                    <field name="name"/>
                                    <field name="stage_id"/>
                                    <field name="user_ids" widget="many2many_tags" optional="show"/>
                                    <field name="op_work_package_id" string="OP WP"/>
                                    <field name="op_sync_state" optional="show"/>
                                    <field name="dev_work_item_id"/>
                                    <button name="action_dev_hub_open_work_item"
                                            type="object"
                                            string="Open Work Item"
                                            icon="fa-external-link"
                                            invisible="not dev_work_item_id"/>
                                    <button name="action_dev_hub_ensure_work_item"
                                            type="object"
                                            string="Ensure Work Item"
                                            icon="fa-plus"
                                            groups="dev_session_hub.group_dev_hub_manager"/>
                                </list>
                            </field>
                        </page>
                        <page string="OpenProject Work Packages">
                            <div class="alert alert-info" role="alert" invisible="has_openproject_mapping">
                                No OpenProject map is linked. Work packages appear after maps are configured and pulled.
                            </div>
                            <group invisible="not has_openproject_mapping">
                                <button name="action_pull_openproject_maps"
                                        type="object"
                                        string="Pull / Refresh"
                                        class="btn-primary"
                                        groups="dev_session_hub.group_dev_hub_manager"/>
                            </group>
                            <field name="mapped_op_task_ids" readonly="1" context="{'dev_project_id': id}">
                                <list>
                                    <field name="op_work_package_id" string="WP ID"/>
                                    <field name="name" string="Subject"/>
                                    <field name="stage_id" string="Status"/>
                                    <field name="user_ids" widget="many2many_tags" optional="show"/>
                                    <field name="id" string="Odoo Task"/>
                                    <field name="dev_work_item_id"/>
                                    <field name="op_last_sync"/>
                                    <field name="op_sync_state"/>
                                    <field name="op_last_error" optional="hide"/>
                                    <field name="op_url" column_invisible="1"/>
                                    <field name="op_attachment_count" string="Atts" optional="show"/>
                                    <button name="action_open_op_url"
                                            type="object"
                                            string="Open in OpenProject"
                                            icon="fa-external-link"
                                            invisible="not op_url"/>
                                    <button name="action_open_op_primary_attachment"
                                            type="object"
                                            string="Open Attachment"
                                            icon="fa-paperclip"
                                            invisible="op_attachment_count == 0"/>
                                    <button name="action_dev_hub_analyze_against_code_database"
                                            type="object"
                                            string="Analyze Code/DB"
                                            icon="fa-search"
                                            groups="dev_session_hub.group_dev_hub_user"/>
                                    <button name="action_dev_hub_open_work_item"
                                            type="object"
                                            string="Open Work Item"
                                            icon="fa-external-link"
                                            invisible="not dev_work_item_id"/>
                                    <button name="action_dev_hub_ensure_work_item"
                                            type="object"
                                            string="Ensure Work Item"
                                            icon="fa-plus"
                                            groups="dev_session_hub.group_dev_hub_manager"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dev_project" model="ir.actions.act_window">
        <field name="name">Projects</field>
        <field name="res_model">dev.project</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_dev_repository_list" model="ir.ui.view">
        <field name="name">dev.repository.list</field>
        <field name="model">dev.repository</field>
        <field name="arch" type="xml">
            <list>
                <field name="project_id"/>
                <field name="name"/>
                <field name="working_directory"/>
                <field name="default_branch"/>
                <field name="current_branch_cache"/>
                <field name="head_cache"/>
                <field name="dirty_state_summary"/>
                <field name="last_git_snapshot_at"/>
            </list>
        </field>
    </record>

    <record id="view_dev_repository_form" model="ir.ui.view">
        <field name="name">dev.repository.form</field>
        <field name="model">dev.repository</field>
        <field name="arch" type="xml">
            <form string="Development Repository">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="project_id"/>
                            <field name="repository_role"/>
                            <field name="git_remote"/>
                            <field name="default_branch"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="canonical_remote_path"/>
                            <field name="working_directory"/>
                            <field name="current_branch_cache" readonly="1"/>
                            <field name="head_cache" readonly="1"/>
                            <field name="last_git_snapshot_at" readonly="1"/>
                        </group>
                    </group>
                    <field name="dirty_state_summary" readonly="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dev_repository" model="ir.actions.act_window">
        <field name="name">Repositories</field>
        <field name="res_model">dev.repository</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_dev_environment_list" model="ir.ui.view">
        <field name="name">dev.environment.list</field>
        <field name="model">dev.environment</field>
        <field name="arch" type="xml">
            <list decoration-danger="is_production">
                <field name="project_id"/>
                <field name="name"/>
                <field name="environment_type"/>
                <field name="environment_role"/>
                <field name="runtime_id"/>
                <field name="machine_id"/>
                <field name="odoo_version"/>
                <field name="database_identifier"/>
                <field name="port"/>
                <field name="service_container_reference"/>
                <field name="is_production"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_dev_environment_form" model="ir.ui.view">
        <field name="name">dev.environment.form</field>
        <field name="model">dev.environment</field>
        <field name="arch" type="xml">
            <form string="Development Environment">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="project_id"/>
                            <field name="environment_type"/>
                            <field name="environment_role"/>
                            <field name="runtime_id"/>
                            <field name="machine_id"/>
                            <field name="odoo_version"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="database_identifier"/>
                            <field name="url"/>
                            <field name="port"/>
                            <field name="config_reference"/>
                            <field name="service_container_reference"/>
                            <field name="data_sensitivity"/>
                            <field name="is_production" readonly="1"/>
                        </group>
                    </group>
                    <group string="Production Guard Policy">
                        <field name="production_guard_policy"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dev_odoo_runtime_list" model="ir.ui.view">
        <field name="name">dev.odoo.runtime.list</field>
        <field name="model">dev.odoo.runtime</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="odoo_major"/>
                <field name="machine_id"/>
                <field name="baseline_database_identifier"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_dev_odoo_runtime_form" model="ir.ui.view">
        <field name="name">dev.odoo.runtime.form</field>
        <field name="model">dev.odoo.runtime</field>
        <field name="arch" type="xml">
            <form string="Odoo Runtime">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="odoo_major"/>
                            <field name="machine_id"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="odoo_bin_path"/>
                            <field name="venv_path"/>
                            <field name="community_addons_path"/>
                            <field name="enterprise_addons_path"/>
                            <field name="baseline_database_identifier"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Addon Sources">
                            <field name="addon_source_ids">
                                <list editable="bottom">
                                    <field name="project_id"/>
                                    <field name="repository_id"/>
                                    <field name="addons_subdirectory"/>
                                    <field name="absolute_addons_root"/>
                                </list>
                            </field>
                        </page>
                        <page string="Environments">
                            <field name="environment_ids" readonly="1">
                                <list>
                                    <field name="project_id"/>
                                    <field name="name"/>
                                    <field name="environment_role"/>
                                    <field name="database_identifier"/>
                                    <field name="port"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dev_odoo_runtime" model="ir.actions.act_window">
        <field name="name">Odoo Runtimes</field>
        <field name="res_model">dev.odoo.runtime</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_dev_environment" model="ir.actions.act_window">
        <field name="name">Environments</field>
        <field name="res_model">dev.environment</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_dev_task_link_list" model="ir.ui.view">
        <field name="name">dev.task.link.list</field>
        <field name="model">dev.task.link</field>
        <field name="arch" type="xml">
            <list>
                <field name="source_system"/>
                <field name="openproject_work_package_id"/>
                <field name="project_id"/>
                <field name="cached_task_title"/>
                <field name="cached_status"/>
                <field name="cached_assignee"/>
                <field name="last_sync_at"/>
            </list>
        </field>
    </record>

    <record id="view_dev_task_link_form" model="ir.ui.view">
        <field name="name">dev.task.link.form</field>
        <field name="model">dev.task.link</field>
        <field name="arch" type="xml">
            <form string="Read-only Task Link">
                <sheet>
                    <group>
                        <group>
                            <field name="source_system"/>
                            <field name="openproject_work_package_id"/>
                            <field name="project_id"/>
                            <field name="reference_url" widget="url"/>
                        </group>
                        <group>
                            <field name="cached_task_title"/>
                            <field name="cached_status"/>
                            <field name="cached_assignee"/>
                            <field name="last_sync_at"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dev_task_link" model="ir.actions.act_window">
        <field name="name">Task Links</field>
        <field name="res_model">dev.task.link</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_dev_policy_list" model="ir.ui.view">
        <field name="name">dev.policy.list</field>
        <field name="model">dev.policy</field>
        <field name="arch" type="xml">
            <list decoration-danger="production_access_policy != 'denied' or deploy_permission">
                <field name="name"/>
                <field name="project_id"/>
                <field name="environment_id"/>
                <field name="production_access_policy"/>
                <field name="development_allowed"/>
                <field name="test_permission"/>
                <field name="deploy_permission"/>
                <field name="launch_allowed"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_dev_policy_form" model="ir.ui.view">
        <field name="name">dev.policy.form</field>
        <field name="model">dev.policy</field>
        <field name="arch" type="xml">
            <form string="Development Policy">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="project_id"/>
                            <field name="environment_id"/>
                            <field name="production_access_policy"/>
                            <field name="required_confirmation"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="development_allowed"/>
                            <field name="agent_write_permission"/>
                            <field name="test_permission"/>
                            <field name="deploy_permission"/>
                            <field name="launch_allowed"/>
                        </group>
                    </group>
                    <group>
                        <field name="allowed_operations"/>
                        <field name="branch_rules"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dev_policy" model="ir.actions.act_window">
        <field name="name">Policies</field>
        <field name="res_model">dev.policy</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
