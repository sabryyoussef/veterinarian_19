{
  "name": "devhub-wa-project-aware-analysis-test",
  "id": "j3xV5kXRQUu1k0p4",
  "active": true,
  "notes": "Sanitized live export. Secrets in n8n env only. Test Odoo URL via DEV_HUB_ODOO_BASE_URL / ODOO_TEST_JSON2_BASE.",
  "nodes": [
    {
      "id": "sched-wa",
