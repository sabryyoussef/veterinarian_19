      "parameters": {
        "method": "POST",
        "url": "={{ ($env.ODOO_TEST_JSON2_BASE || $env.DEV_HUB_ODOO_BASE_URL) + '/json/2/dev.whatsapp.analysis.job/service_fail' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.DEV_HUB_WA_ANALYSIS_ODOO_API_KEY }}"
