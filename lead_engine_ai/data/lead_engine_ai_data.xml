<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Default system parameters (only set if not already present) -->
    <record id="param_llm_provider" model="ir.config_parameter">
        <field name="key">lead_engine_ai.llm_provider</field>
        <field name="value">openai</field>
    </record>

    <record id="param_llm_model" model="ir.config_parameter">
        <field name="key">lead_engine_ai.llm_model</field>
