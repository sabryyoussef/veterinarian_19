<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_lead_engine" model="res.groups.privilege">
        <field name="name">Lead Engine</field>
        <field name="sequence">50</field>
        <field name="category_id" ref="base.module_category_sales_crm"/>
    </record>

    <record id="group_lead_engine_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_lead_engine"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>

    <record id="group_lead_engine_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_lead_engine"/>
        <field name="implied_ids" eval="[(4, ref('group_lead_engine_user'))]"/>
    </record>

    <record id="group_lead_engine_integration" model="res.groups">
        <field name="name">Integration</field>
        <field name="privilege_id" ref="res_groups_privilege_lead_engine"/>
        <field name="comment">Reserved for future technical/API-focused roles; currently implies Manager (same configuration access).</field>
        <field name="implied_ids" eval="[(4, ref('group_lead_engine_manager'))]"/>
    </record>
</odoo>
