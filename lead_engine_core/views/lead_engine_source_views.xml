<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lead_engine_source_list" model="ir.ui.view">
        <field name="name">lead.engine.source.list</field>
        <field name="model">lead.engine.source</field>
        <field name="arch" type="xml">
            <list string="Lead Engine Sources">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="channel"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_lead_engine_source_form" model="ir.ui.view">
        <field name="name">lead.engine.source.form</field>
        <field name="model">lead.engine.source</field>
        <field name="arch" type="xml">
            <form string="Lead Engine source">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div
                        class="alert alert-info mb-3"
                        role="alert"
                        colspan="2"
                        groups="lead_engine_core.group_lead_engine_manager"
                    >
                        <strong>Tip:</strong>
                        Changing <em>Code</em> or company breaks existing integrations that use the old value.
                        Archive unused sources instead of reusing codes for a different meaning.
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="channel"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="default_team_id"/>
                            <field name="default_user_id"/>
                            <field name="auto_score"/>
                            <field name="auto_assign"/>
                        </group>
                    </group>
                    <group string="UTM alignment">
                        <field name="utm_source_id"/>
                        <field name="utm_medium_id"/>
                        <field name="utm_campaign_id"/>
                    </group>
                    <group string="Notes">
                        <field name="description" placeholder="Operator documentation"/>
                        <field name="note" placeholder="Internal notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_lead_engine_source" model="ir.actions.act_window">
        <field name="name">Sources</field>
        <field name="res_model">lead.engine.source</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
