<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_lead_view_pivot_lead_engine_source" model="ir.ui.view">
        <field name="name">crm.lead.pivot.lead.engine.source</field>
        <field name="model">crm.lead</field>
        <field name="arch" type="xml">
            <pivot string="Leads by Lead Engine source" sample="1">
                <field name="lead_engine_source_id" type="row"/>
            </pivot>
        </field>
    </record>

    <record id="crm_lead_view_pivot_qualification" model="ir.ui.view">
        <field name="name">crm.lead.pivot.qualification</field>
        <field name="model">crm.lead</field>
        <field name="arch" type="xml">
            <pivot string="Qualification state" sample="1">
                <field name="qualification_state" type="col"/>
                <field name="lead_engine_source_id" type="row"/>
            </pivot>
        </field>
    </record>

    <record id="crm_lead_view_pivot_assignment" model="ir.ui.view">
        <field name="name">crm.lead.pivot.assignment</field>
        <field name="model">crm.lead</field>
        <field name="arch" type="xml">
            <pivot string="Assignment status" sample="1">
                <field name="assignment_status" type="row"/>
                <field name="lead_engine_source_id" type="row"/>
            </pivot>
        </field>
    </record>

    <record id="crm_lead_view_graph_lead_engine_source" model="ir.ui.view">
        <field name="name">crm.lead.graph.lead.engine.source</field>
        <field name="model">crm.lead</field>
        <field name="arch" type="xml">
            <graph string="Leads by source" type="bar" sample="1">
                <field name="lead_engine_source_id"/>
            </graph>
        </field>
    </record>

    <record id="action_lead_engine_leads_by_source" model="ir.actions.act_window">
        <field name="name">Leads by source</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="crm.view_crm_case_leads_filter"/>
        <field name="context">{'search_default_type': 'lead'}</field>
    </record>

    <record id="action_lead_engine_leads_by_source_pivot" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="crm_lead_view_pivot_lead_engine_source"/>
        <field name="act_window_id" ref="action_lead_engine_leads_by_source"/>
    </record>

    <record id="action_lead_engine_leads_by_source_graph" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="crm_lead_view_graph_lead_engine_source"/>
        <field name="act_window_id" ref="action_lead_engine_leads_by_source"/>
    </record>

    <record id="action_lead_engine_qualification_mix" model="ir.actions.act_window">
        <field name="name">Qualification overview</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">pivot,list</field>
        <field name="search_view_id" ref="crm.view_crm_case_leads_filter"/>
    </record>

    <record id="action_lead_engine_qualification_mix_pivot" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="crm_lead_view_pivot_qualification"/>
        <field name="act_window_id" ref="action_lead_engine_qualification_mix"/>
    </record>

    <record id="action_lead_engine_qualification_mix_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="crm.crm_case_tree_view_leads"/>
        <field name="act_window_id" ref="action_lead_engine_qualification_mix"/>
    </record>

    <record id="action_lead_engine_assignment_mix" model="ir.actions.act_window">
        <field name="name">Assignment overview</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">pivot,list</field>
        <field name="search_view_id" ref="crm.view_crm_case_leads_filter"/>
    </record>

    <record id="action_lead_engine_assignment_mix_pivot" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="crm_lead_view_pivot_assignment"/>
        <field name="act_window_id" ref="action_lead_engine_assignment_mix"/>
    </record>

    <record id="action_lead_engine_assignment_mix_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="crm.crm_case_tree_view_leads"/>
        <field name="act_window_id" ref="action_lead_engine_assignment_mix"/>
    </record>

    <record id="action_lead_engine_leads_by_source_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="3"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="crm.crm_case_tree_view_leads"/>
        <field name="act_window_id" ref="action_lead_engine_leads_by_source"/>
    </record>
</odoo>
