<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="lead_engine_intake_log_view_pivot_status" model="ir.ui.view">
        <field name="name">lead.engine.intake.log.pivot.status</field>
        <field name="model">lead.engine.intake.log</field>
        <field name="arch" type="xml">
            <pivot string="Intake by status" sample="1">
                <field name="status" type="col"/>
                <field name="source_id" type="row"/>
            </pivot>
        </field>
    </record>

    <record id="action_lead_engine_intake_analytics" model="ir.actions.act_window">
        <field name="name">Intake analytics</field>
        <field name="res_model">lead.engine.intake.log</field>
        <field name="view_mode">pivot,list</field>
    </record>

    <record id="action_lead_engine_intake_analytics_pivot" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="lead_engine_intake_log_view_pivot_status"/>
        <field name="act_window_id" ref="action_lead_engine_intake_analytics"/>
    </record>

    <record id="action_lead_engine_intake_analytics_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="lead_engine_core.view_lead_engine_intake_log_list"/>
        <field name="act_window_id" ref="action_lead_engine_intake_analytics"/>
    </record>
</odoo>
