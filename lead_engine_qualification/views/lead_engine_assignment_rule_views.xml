<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lead_engine_assignment_rule_list" model="ir.ui.view">
        <field name="name">lead.engine.assignment.rule.list</field>
        <field name="model">lead.engine.assignment.rule</field>
        <field name="arch" type="xml">
            <list string="Assignment Rules" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="stop_processing"/>
            </list>
        </field>
    </record>

    <record id="view_lead_engine_assignment_rule_form" model="ir.ui.view">
        <field name="name">lead.engine.assignment.rule.form</field>
        <field name="model">lead.engine.assignment.rule</field>
        <field name="arch" type="xml">
            <form string="Assignment rule">
                <sheet>
                    <div class="alert alert-warning mb-3" role="alert" colspan="2">
                        <strong>Order matters:</strong>
                        The first <em>active</em> rule that matches (sequence, then id) and sets a team and/or user wins.
                        Invalid domains are skipped at runtime—verify behaviour in a safe environment.
                    </div>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="active"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="stop_processing"/>
                    </group>
                    <group string="Match">
                        <field name="source_id"/>
                        <field name="le_channel"/>
                        <field name="min_score"/>
                        <field name="max_score"/>
                        <field name="domain_expression" widget="text"/>
                    </group>
                    <group string="Assign">
                        <field name="team_id"/>
                        <field name="user_id"/>
                    </group>
                    <group>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_lead_engine_assignment_rule" model="ir.actions.act_window">
        <field name="name">Assignment Rules</field>
        <field name="res_model">lead.engine.assignment.rule</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
