<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lead_engine_score_rule_list" model="ir.ui.view">
        <field name="name">lead.engine.score.rule.list</field>
        <field name="model">lead.engine.score.rule</field>
        <field name="arch" type="xml">
            <list string="Score Rules" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="rule_type"/>
                <field name="score_delta"/>
            </list>
        </field>
    </record>

    <record id="view_lead_engine_score_rule_form" model="ir.ui.view">
        <field name="name">lead.engine.score.rule.form</field>
        <field name="model">lead.engine.score.rule</field>
        <field name="arch" type="xml">
            <form string="Score rule">
                <sheet>
                    <div class="alert alert-info mb-3" role="alert" colspan="2">
                        Scores are <strong>additive</strong> across all matching rules (then clamped). Narrow rules with
                        <em>Source</em> / <em>Channel</em> to avoid surprising totals.
                    </div>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="active"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <group string="Match">
                        <field name="rule_type"/>
                        <field name="field_name" invisible="rule_type != 'field'"/>
                        <field name="operator" invisible="rule_type != 'field'"/>
                        <field name="value" invisible="rule_type != 'field'"/>
                        <field name="value_json" invisible="rule_type != 'field' or operator != 'in'"/>
                        <field name="source_id"/>
                        <field name="le_channel"/>
                    </group>
                    <group string="Score">
                        <field name="score_delta"/>
                    </group>
                    <group>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_lead_engine_score_rule" model="ir.actions.act_window">
        <field name="name">Score Rules</field>
        <field name="res_model">lead.engine.score.rule</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
