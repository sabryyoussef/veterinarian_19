<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lead_engine_playbook_start_wizard_form" model="ir.ui.view">
        <field name="name">lead.engine.playbook.start.wizard.form</field>
        <field name="model">lead.engine.playbook.start.wizard</field>
        <field name="arch" type="xml">
            <form string="Start playbook">
                <group>
                    <field name="lead_id" readonly="1"/>
                    <field name="company_id" invisible="1"/>
                    <field name="playbook_id"/>
                    <field name="allow_duplicate_lead"/>
                    <field name="allow_duplicate_active_run"/>
                </group>
                <footer>
                    <button name="action_start_playbook" string="Start" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
