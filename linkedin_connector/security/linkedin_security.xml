<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_linkedin" model="ir.module.category">
        <field name="name">LinkedIn</field>
        <field name="sequence">60</field>
    </record>

    <record id="privilege_linkedin" model="res.groups.privilege">
        <field name="name">LinkedIn</field>
        <field name="sequence">60</field>
        <field name="category_id" ref="module_category_linkedin"/>
    </record>

    <record id="group_linkedin_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_linkedin"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_linkedin_job_hunt" model="res.groups">
        <field name="name">Job Hunt Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_linkedin"/>
        <field name="implied_ids" eval="[(4, ref('group_linkedin_user'))]"/>
        <field name="comment">Can approve applications and open apply URLs after approval.</field>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>
