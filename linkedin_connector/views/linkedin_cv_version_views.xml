<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_linkedin_cv_version_list" model="ir.ui.view">
        <field name="name">linkedin.cv.version.list</field>
        <field name="model">linkedin.cv.version</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="account_id"/>
                <field name="attachment_name"/>
                <field name="is_default"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_linkedin_cv_version_form" model="ir.ui.view">
        <field name="name">linkedin.cv.version.form</field>
        <field name="model">linkedin.cv.version</field>
        <field name="arch" type="xml">
            <form string="CV Version">
                <header>
                    <button name="action_set_default" type="object" string="Set as default"
                            class="btn-secondary" invisible="is_default"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="account_id"/>
                        <field name="attachment_id"/>
                        <field name="attachment_name"/>
                        <field name="resume_id"/>
                        <field name="is_default"/>
                        <field name="active"/>
                    </group>
                    <field name="notes" placeholder="Notes about this CV version…"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_linkedin_cv_version" model="ir.actions.act_window">
        <field name="name">CV Versions</field>
        <field name="res_model">linkedin.cv.version</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
