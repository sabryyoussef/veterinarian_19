<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_linkedin_candidate_profile_form" model="ir.ui.view">
        <field name="name">linkedin.candidate.profile.form</field>
        <field name="model">linkedin.candidate.profile</field>
        <field name="arch" type="xml">
            <form string="Candidate Profile">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="account_id"/>
                        <field name="active"/>
                        <field name="partner_id"/>
                    </group>
                    <group string="Experience (confirmed only)">
                        <field name="years_odoo_experience"/>
                        <field name="technical_skills"/>
                        <field name="functional_skills"/>
                    </group>
                    <group string="Preferences (leave unset if unconfirmed)">
                        <field name="salary_expectation"/>
                        <field name="notice_period"/>
                        <field name="uae_relocation"/>
                        <field name="visa_sponsorship"/>
                        <field name="work_mode_preference"/>
                    </group>
                    <group string="Links">
                        <field name="github_url"/>
                        <field name="linkedin_url"/>
                        <field name="portfolio_url"/>
                        <field name="email"/>
                        <field name="phone"/>
                    </group>
                    <group string="Standard answers JSON">
                        <field name="standard_answers_json" colspan="2"/>
                        <field name="notes" colspan="2"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_linkedin_candidate_profile_list" model="ir.ui.view">
        <field name="name">linkedin.candidate.profile.list</field>
        <field name="model">linkedin.candidate.profile</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="account_id"/>
                <field name="years_odoo_experience"/>
                <field name="work_mode_preference"/>
            </list>
        </field>
    </record>
    <record id="action_linkedin_candidate_profile" model="ir.actions.act_window">
        <field name="name">Application Profile</field>
        <field name="res_model">linkedin.candidate.profile</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('account_id', '=', 2)]</field>
        <field name="context">{'default_account_id': 2}</field>
    </record>
    <menuitem id="menu_linkedin_candidate_profile"
              name="Application Profile"
              parent="menu_linkedin_jobs"
              action="action_linkedin_candidate_profile"
              sequence="45"/>

    <record id="view_linkedin_apply_policy_form" model="ir.ui.view">
        <field name="name">linkedin.apply.policy.form</field>
        <field name="model">linkedin.apply.policy</field>
        <field name="arch" type="xml">
            <form string="Application Policy / Dashboard">
                <sheet>
                    <group string="Controls">
                        <field name="name"/>
                        <field name="account_id"/>
                        <field name="kill_switch"/>
                        <field name="auto_track_enabled"/>
                        <field name="browser_submit_enabled"/>
                        <field name="email_submit_enabled"/>
                        <field name="allowed_platforms"/>
                        <field name="min_score"/>
                        <field name="max_submits_per_day"/>
                        <field name="max_submits_per_week"/>
                        <field name="max_submits_per_month"/>
                        <field name="min_minutes_between_submits"/>
                        <field name="company_cooldown_days"/>
                    </group>
                    <group string="Personal dashboard (account)">
                        <field name="jobs_count"/>
                        <field name="applications_count"/>
                        <field name="attempts_count"/>
                        <field name="human_required_count"/>
                        <field name="submission_unknown_count"/>
                        <field name="applied_today_count"/>
                        <field name="remaining_daily_limit"/>
                        <field name="remaining_weekly_limit"/>
                        <field name="profile_id"/>
                        <field name="ats_sources_checked"/>
                        <field name="new_direct_ats_jobs"/>
                        <field name="safe_canary_count"/>
                        <field name="last_discovery_run"/>
                        <field name="next_discovery_run"/>
                    </group>
                    <div class="text-muted">
                        Submit flags default OFF. Kill switch default ON. LinkedIn auto-submit is always prohibited.
                        Use the Jobs menu filters for Human Required / Submission Unknown / Applied Today.
                    </div>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_linkedin_apply_policy_list" model="ir.ui.view">
        <field name="name">linkedin.apply.policy.list</field>
        <field name="model">linkedin.apply.policy</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="account_id"/>
                <field name="kill_switch"/>
                <field name="applied_today_count"/>
                <field name="remaining_daily_limit"/>
                <field name="remaining_weekly_limit"/>
            </list>
        </field>
    </record>
    <record id="action_linkedin_apply_policy" model="ir.actions.act_window">
        <field name="name">Application Policy</field>
        <field name="res_model">linkedin.apply.policy</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('account_id', '=', 2)]</field>
        <field name="context">{'default_account_id': 2}</field>
    </record>
    <menuitem id="menu_linkedin_apply_policy"
              name="Application Policy"
              parent="menu_linkedin_jobs"
              action="action_linkedin_apply_policy"
              sequence="5"/>

    <record id="view_linkedin_apply_attempt_list" model="ir.ui.view">
        <field name="name">linkedin.apply.attempt.list</field>
        <field name="model">linkedin.apply.attempt</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="application_id"/>
                <field name="platform"/>
                <field name="state"/>
                <field name="dry_run"/>
                <field name="stop_reason"/>
            </list>
        </field>
    </record>
    <record id="action_linkedin_apply_attempt" model="ir.actions.act_window">
        <field name="name">Attempts</field>
        <field name="res_model">linkedin.apply.attempt</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('account_id', '=', 2)]</field>
    </record>
    <menuitem id="menu_linkedin_apply_attempt"
              name="Attempts"
              parent="menu_linkedin_jobs"
              action="action_linkedin_apply_attempt"
              sequence="46"/>

    <!-- Filtered menus for personal account id=2 -->
    <record id="action_linkedin_jobs_personal" model="ir.actions.act_window">
        <field name="name">Jobs</field>
        <field name="res_model">linkedin.job</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('account_id', '=', 2)]</field>
        <field name="context">{'default_account_id': 2}</field>
    </record>
    <menuitem id="menu_linkedin_jobs_personal_dash"
              name="Jobs (Personal)"
              parent="menu_linkedin_jobs"
              action="action_linkedin_jobs_personal"
              sequence="1"/>

    <record id="action_linkedin_apps_human_required" model="ir.actions.act_window">
        <field name="name">Human Required</field>
        <field name="res_model">linkedin.job.application</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('account_id', '=', 2), ('state', '=', 'human_required')]</field>
    </record>
    <menuitem id="menu_linkedin_apps_human_required"
              name="Human Required"
              parent="menu_linkedin_jobs"
              action="action_linkedin_apps_human_required"
              sequence="50"/>

    <record id="action_linkedin_apps_submission_unknown" model="ir.actions.act_window">
        <field name="name">Submission Unknown</field>
        <field name="res_model">linkedin.job.application</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('account_id', '=', 2), ('state', '=', 'submission_unknown')]</field>
    </record>
    <menuitem id="menu_linkedin_apps_submission_unknown"
              name="Submission Unknown"
              parent="menu_linkedin_jobs"
              action="action_linkedin_apps_submission_unknown"
              sequence="51"/>

    <record id="action_linkedin_apps_applied_today" model="ir.actions.act_window">
        <field name="name">Applied Today</field>
        <field name="res_model">linkedin.job.application</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('account_id', '=', 2), ('state', '=', 'applied')]</field>
        <field name="context">{'search_default_applied_today': 1}</field>
    </record>
    <menuitem id="menu_linkedin_apps_applied_today"
              name="Applied Today"
              parent="menu_linkedin_jobs"
              action="action_linkedin_apps_applied_today"
              sequence="52"/>

    <record id="view_linkedin_ats_source_list" model="ir.ui.view">
        <field name="name">linkedin.ats.source.list</field>
        <field name="model">linkedin.ats.source</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="ats_type"/>
                <field name="company"/>
                <field name="region"/>
                <field name="enabled"/>
                <field name="last_check_at"/>
                <field name="last_http_status"/>
                <field name="last_jobs_found"/>
                <field name="consecutive_failures"/>
            </list>
        </field>
    </record>
    <record id="view_linkedin_ats_source_form" model="ir.ui.view">
        <field name="name">linkedin.ats.source.form</field>
        <field name="model">linkedin.ats.source</field>
        <field name="arch" type="xml">
            <form string="ATS Source">
                <header>
                    <button name="action_run_now" type="object" string="Run discovery now" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="ats_type"/>
                        <field name="board_token"/>
                        <field name="feed_url"/>
                        <field name="company"/>
                        <field name="region"/>
                        <field name="enabled"/>
                    </group>
                    <group string="Last check">
                        <field name="last_check_at"/>
                        <field name="last_http_status"/>
                        <field name="last_jobs_found"/>
                        <field name="consecutive_failures"/>
                        <field name="last_error"/>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_linkedin_ats_source" model="ir.actions.act_window">
        <field name="name">ATS Sources</field>
        <field name="res_model">linkedin.ats.source</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_linkedin_ats_source"
              name="ATS Sources"
              parent="menu_linkedin_jobs"
              action="action_linkedin_ats_source"
              sequence="6"/>

    <record id="action_linkedin_jobs_safe_canary" model="ir.actions.act_window">
        <field name="name">Safe Canary Candidates</field>
        <field name="res_model">linkedin.job</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('account_id', '=', 2), ('discovery_class', '=', 'safe_canary_candidate')]</field>
    </record>
    <menuitem id="menu_linkedin_jobs_safe_canary"
              name="Safe Canary Candidates"
              parent="menu_linkedin_jobs"
              action="action_linkedin_jobs_safe_canary"
              sequence="7"/>
</odoo>
