<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_linkedin_config_settings_form" model="ir.ui.view">
        <field name="name">linkedin.config.settings.form</field>
        <field name="model">res.config.settings</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <form string="LinkedIn Connector Settings" class="oe_form_configuration">
                <header>
                    <button string="Save" type="object" name="execute"
                            class="btn-primary" data-hotkey="s"/>
                    <button string="Discard" type="object" name="cancel"
                            class="btn-secondary" special="cancel"/>
                </header>
                <sheet>
                    <h2>LinkedIn Connector</h2>
                    <group string="Job Search (JSearch API via RapidAPI)">
                        <field name="linkedin_rapidapi_key"
                               placeholder="Paste your X-RapidAPI-Key here"
                               password="True"/>
                        <div colspan="2" class="text-muted small">
                            Free tier: 200 requests/month. Sign up at
                            rapidapi.com → search "JSearch" → subscribe (free plan) →
                            copy the X-RapidAPI-Key value shown in the API console.
                        </div>
                    </group>
                    <group string="Senior Odoo job hunt">
                        <field name="linkedin_live_job_search_enabled"/>
                        <field name="linkedin_job_score_threshold"/>
                        <field name="linkedin_job_search_queries"/>
                        <field name="linkedin_job_search_locations"/>
                        <field name="linkedin_job_preferred_geos"/>
                        <div colspan="2" class="text-muted small">
                            Keep live job search OFF until UAT evidence is approved.
                            No Easy Apply automation — applications stay review-first.
                        </div>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_linkedin_config_settings" model="ir.actions.act_window">
        <field name="name">LinkedIn Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="view_id" ref="view_linkedin_config_settings_form"/>
    </record>

    <menuitem id="menu_linkedin_settings"
              name="Settings"
              parent="menu_linkedin_config"
              action="action_linkedin_config_settings"
              sequence="20"/>

</odoo>
