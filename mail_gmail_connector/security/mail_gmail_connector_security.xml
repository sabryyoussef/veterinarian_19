<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_mail_gmail">
        <field name="name">Gmail connector</field>
        <field name="sequence">65</field>
        <field name="category_id" ref="base.module_category_productivity"/>
    </record>

    <record id="group_gmail_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_mail_gmail"/>
    </record>

    <record id="group_gmail_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_mail_gmail"/>
        <field name="implied_ids" eval="[(4, ref('group_gmail_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="mail_gmail_account_rule_user" model="ir.rule">
        <field name="name">Gmail account: responsible user only</field>
        <field name="model_id" ref="model_mail_gmail_account"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_gmail_user'))]"/>
    </record>

    <record id="mail_gmail_account_rule_manager" model="ir.rule">
        <field name="name">Gmail account: full access (managers)</field>
        <field name="model_id" ref="model_mail_gmail_account"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_gmail_manager'))]"/>
    </record>
</odoo>
