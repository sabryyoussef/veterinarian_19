<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mail_gmail_fetch_import_wizard_form" model="ir.ui.view">
        <field name="name">mail.gmail.fetch.import.wizard.form</field>
        <field name="model">mail.gmail.fetch.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Search Gmail and import">
                <sheet>
                    <group string="Mailbox">
                        <field name="account_id" options="{'no_create': True}"/>
                        <field name="incoming_mail_server_id" invisible="1"/>
                        <field name="max_messages"/>
                    </group>
                    <group string="Match messages">
                        <field name="scope_base"/>
                        <field name="label_source"/>
                        <field name="sender"/>
                        <field name="subject_contains"/>
                        <field name="contains_words"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="only_primary_category"/>
                    </group>
                    <group string="Exclude noise (Gmail search)">
                        <field name="exclude_spam_trash"/>
                        <field name="exclude_category_tabs"/>
                        <field name="exclude_youtube"/>
                        <field name="exclude_bulk_senders"/>
                    </group>
                    <group string="Advanced">
                        <field name="extra_gmail_query" placeholder="-larger:1M"/>
                    </group>
                    <group string="Result" invisible="not result_html">
                        <field name="result_html" nolabel="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_preview" type="object" string="Preview matches" class="btn-secondary"/>
                    <button name="action_import" type="object" string="Import into Odoo" class="btn-primary"/>
                    <button name="action_open_incoming_server" type="object" string="Incoming mail server"
                            class="btn-secondary"
                            invisible="not incoming_mail_server_id"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_mail_gmail_fetch_import_wizard" model="ir.actions.act_window">
        <field name="name">Search Gmail and import</field>
        <field name="res_model">mail.gmail.fetch.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{}</field>
    </record>
</odoo>
