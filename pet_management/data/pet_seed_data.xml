<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">
    <!-- Foundational reference data only (species + breeds).
         Demo pets, appointments, visits, etc. live in pet_demo_data.xml
         which is NOT loaded by the module. -->

    <record id="species_dog" model="pet.species">
      <field name="name">Dog</field>
      <field name="code">DOG</field>
      <field name="color">1</field>
      <field name="company_id" ref="base.main_company"/>
    </record>

    <record id="species_cat" model="pet.species">
      <field name="name">Cat</field>
      <field name="code">CAT</field>
      <field name="color">2</field>
      <field name="company_id" ref="base.main_company"/>
    </record>

    <record id="species_rabbit" model="pet.species">
      <field name="name">Rabbit</field>
      <field name="code">RABBIT</field>
      <field name="color">3</field>
      <field name="company_id" ref="base.main_company"/>
    </record>

    <record id="species_bird" model="pet.species">
      <field name="name">Bird</field>
      <field name="code">BIRD</field>
      <field name="color">4</field>
      <field name="company_id" ref="base.main_company"/>
    </record>

    <record id="species_hamster" model="pet.species">
      <field name="name">Hamster</field>
      <field name="code">HAMSTER</field>
      <field name="color">5</field>
      <field name="company_id" ref="base.main_company"/>
    </record>

    <record id="breed_labrador" model="pet.breed">
      <field name="name">Labrador Retriever</field>
      <field name="species_id" ref="species_dog"/>
      <field name="color">3</field>
      <field name="company_id" ref="base.main_company"/>
      <field name="life_expectancy_min">10</field>
      <field name="life_expectancy_max">14</field>
      <field name="average_weight_min">25.0</field>
      <field name="average_weight_max">35.0</field>
    </record>

    <record id="breed_golden_retriever" model="pet.breed">
      <field name="name">Golden Retriever</field>
      <field name="species_id" ref="species_dog"/>
      <field name="color">4</field>
      <field name="company_id" ref="base.main_company"/>
      <field name="life_expectancy_min">10</field>
      <field name="life_expectancy_max">12</field>
      <field name="average_weight_min">25.0</field>
      <field name="average_weight_max">35.0</field>
    </record>

    <record id="breed_persian" model="pet.breed">
      <field name="name">Persian</field>
      <field name="species_id" ref="species_cat"/>
      <field name="color">2</field>
      <field name="company_id" ref="base.main_company"/>
      <field name="life_expectancy_min">12</field>
      <field name="life_expectancy_max">17</field>
      <field name="average_weight_min">3.5</field>
      <field name="average_weight_max">5.5</field>
    </record>

    <record id="breed_maine_coon" model="pet.breed">
      <field name="name">Maine Coon</field>
      <field name="species_id" ref="species_cat"/>
      <field name="color">3</field>
      <field name="company_id" ref="base.main_company"/>
      <field name="life_expectancy_min">12</field>
      <field name="life_expectancy_max">15</field>
      <field name="average_weight_min">4.5</field>
      <field name="average_weight_max">8.0</field>
    </record>

    <record id="breed_angora" model="pet.breed">
      <field name="name">Angora</field>
      <field name="species_id" ref="species_rabbit"/>
      <field name="color">1</field>
      <field name="company_id" ref="base.main_company"/>
      <field name="life_expectancy_min">7</field>
      <field name="life_expectancy_max">12</field>
      <field name="average_weight_min">2.0</field>
      <field name="average_weight_max">4.0</field>
    </record>

    <record id="breed_cockatiel" model="pet.breed">
      <field name="name">Cockatiel</field>
      <field name="species_id" ref="species_bird"/>
      <field name="color">2</field>
      <field name="company_id" ref="base.main_company"/>
      <field name="life_expectancy_min">15</field>
      <field name="life_expectancy_max">25</field>
      <field name="average_weight_min">0.08</field>
      <field name="average_weight_max">0.12</field>
    </record>

    <record id="breed_syrian" model="pet.breed">
      <field name="name">Syrian Hamster</field>
      <field name="species_id" ref="species_hamster"/>
      <field name="color">1</field>
      <field name="company_id" ref="base.main_company"/>
      <field name="life_expectancy_min">2</field>
      <field name="life_expectancy_max">3</field>
      <field name="average_weight_min">0.1</field>
      <field name="average_weight_max">0.2</field>
    </record>
  </data>
</odoo>
