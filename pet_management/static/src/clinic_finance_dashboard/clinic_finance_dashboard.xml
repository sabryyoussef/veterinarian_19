<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="pet_management.ClinicFinanceDashboard">
        <div class="o_pet_clinic_finance_dashboard">
            <header class="o_cf_header">
                <div class="o_cf_brand">
                    <span class="o_cf_brand_kicker">PetSpot El Sahel</span>
                    <h1 class="o_cf_brand_title">Clinic Finance</h1>
                    <p class="o_cf_brand_sub">المالية · Cash, InstaPay &amp; partner dues</p>
                </div>
                <div class="o_cf_toolbar">
                    <div class="o_cf_periods" role="group" aria-label="Period">
                        <button type="button"
                                class="o_cf_period_btn"
                                data-period="today"
                                t-att-class="{'is-active': state.period === 'today'}"
                                t-on-click="onPeriodClick">Today</button>
                        <button type="button"
                                class="o_cf_period_btn"
                                data-period="week"
                                t-att-class="{'is-active': state.period === 'week'}"
                                t-on-click="onPeriodClick">Week</button>
                        <button type="button"
                                class="o_cf_period_btn"
                                data-period="month"
                                t-att-class="{'is-active': state.period === 'month'}"
                                t-on-click="onPeriodClick">Month</button>
                    </div>
                    <div class="o_cf_actions">
                        <button type="button" class="o_cf_btn o_cf_btn_primary" t-on-click="openQuickExpense">
                            Quick Expense
                        </button>
                        <button type="button" class="o_cf_btn o_cf_btn_ghost" t-on-click="openExpenses">
                            All Expenses
                        </button>
                        <button type="button" class="o_cf_btn o_cf_btn_ghost" t-on-click="load" t-att-disabled="state.loading">
                            Refresh
                        </button>
                    </div>
                </div>
            </header>

            <div t-if="state.loading" class="o_cf_loading">Loading balances…</div>
            <div t-if="state.error" class="o_cf_error" t-esc="state.error"/>

            <t t-if="state.data and !state.loading">
                <t t-set="sections" t-value="state.data.sections"/>
                <p class="o_cf_range">
                    Showing
                    <t t-esc="state.data.date_from"/>
                    →
                    <t t-esc="state.data.date_to"/>
                    · amounts in EGP
                </p>

                <!-- Liquidity -->
                <section class="o_cf_section">
                    <div class="o_cf_section_head">
                        <h2 class="o_cf_section_title">On hand</h2>
                        <span class="o_cf_section_ar">السيولة</span>
                    </div>
                    <div class="o_cf_grid o_cf_grid_wide">
                        <t t-foreach="sections.liquidity.cards" t-as="card" t-key="card.id">
                            <div class="o_cf_tile o_cf_tile_liquidity">
                                <span class="o_cf_tile_label" t-esc="card.label"/>
                                <div class="o_cf_tile_amount" t-att-class="amountClass(card.amount)">
                                    <t t-esc="formatAmount(card.amount)"/>
                                    <span class="o_cf_tile_currency">EGP</span>
                                </div>
                                <span class="o_cf_tile_label_ar" t-esc="card.label_ar"/>
                            </div>
                        </t>
                    </div>
                </section>

                <!-- Partner dues -->
                <section class="o_cf_section" t-if="sections.partner_liability.cards.length">
                    <div class="o_cf_section_head">
                        <h2 class="o_cf_section_title">Due to partners</h2>
                        <span class="o_cf_section_ar">مستحقات الشركاء</span>
                    </div>
                    <div class="o_cf_grid">
                        <t t-foreach="sections.partner_liability.cards" t-as="card" t-key="card.id">
                            <div class="o_cf_tile o_cf_tile_partner">
                                <span class="o_cf_tile_label">
                                    <t t-if="card.technical_code === 'sabry'">Due to Sabry</t>
                                    <t t-elif="card.technical_code === 'ahmed'">Due to Ahmed</t>
                                    <t t-else="">
                                        <t t-esc="card.label"/>
                                    </t>
                                </span>
                                <div class="o_cf_tile_amount" t-att-class="amountClass(card.amount, 'partner')">
                                    <t t-esc="formatAmount(card.amount)"/>
                                    <span class="o_cf_tile_currency">EGP</span>
                                </div>
                                <span class="o_cf_tile_label_ar">
                                    <t t-if="card.technical_code === 'sabry'">مستحق لصبري</t>
                                    <t t-elif="card.technical_code === 'ahmed'">مستحق لأحمد</t>
                                    <t t-else="">
                                        <t t-esc="card.label_ar"/>
                                    </t>
                                </span>
                            </div>
                        </t>
                    </div>
                </section>

                <!-- Performance -->
                <section class="o_cf_section">
                    <div class="o_cf_section_head">
                        <h2 class="o_cf_section_title">Period performance</h2>
                        <span class="o_cf_section_ar">الأداء</span>
                    </div>

                    <div class="o_cf_hero_row">
                        <t t-foreach="heroCards" t-as="card" t-key="card.key">
                            <div t-att-class="card.key === 'net_profit_loss' ? 'o_cf_tile o_cf_tile_perf o_cf_tile_hero' : 'o_cf_tile o_cf_tile_perf'">
                                <span class="o_cf_tile_label" t-esc="card.label"/>
                                <div class="o_cf_tile_amount" t-att-class="amountClass(card.amount, card.key === 'net_profit_loss' ? 'net' : 'flow')">
                                    <t t-esc="formatAmount(card.amount)"/>
                                    <span class="o_cf_tile_currency">EGP</span>
                                </div>
                                <span class="o_cf_tile_label_ar" t-esc="card.label_ar"/>
                            </div>
                        </t>
                    </div>

                    <div class="o_cf_secondary_grid">
                        <t t-foreach="secondaryCards" t-as="card" t-key="card.key">
                            <div class="o_cf_tile o_cf_tile_perf o_cf_tile_soft">
                                <span class="o_cf_tile_label" t-esc="card.label"/>
                                <div class="o_cf_tile_amount" t-att-class="amountClass(card.amount, 'flow')">
                                    <t t-esc="formatAmount(card.amount)"/>
                                    <span class="o_cf_tile_currency">EGP</span>
                                </div>
                                <span class="o_cf_tile_label_ar" t-esc="card.label_ar"/>
                            </div>
                        </t>
                    </div>
                </section>
            </t>
        </div>
    </t>
</templates>
