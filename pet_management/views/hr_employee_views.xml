<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_pet_vet" model="ir.ui.view">
        <field name="name">hr.employee.form.pet.vet</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_vet_appointments" type="object"
                        class="oe_stat_button" icon="fa-calendar"
                        invisible="appointment_count == 0">
                    <field name="appointment_count" widget="statinfo" string="Appointments"/>
                </button>
                <button name="action_view_vet_medical_visits" type="object"
                        class="oe_stat_button" icon="fa-stethoscope"
                        invisible="medical_visit_count == 0">
                    <field name="medical_visit_count" widget="statinfo" string="Medical Visits"/>
                </button>
                <button name="action_view_vet_incomplete_cases" type="object"
                        class="oe_stat_button" icon="fa-exclamation-triangle"
                        invisible="incomplete_case_count == 0">
                    <field name="incomplete_case_count" widget="statinfo" string="Incomplete Cases"/>
                </button>
                <button name="action_view_vet_diagnostics" type="object"
                        class="oe_stat_button" icon="fa-flask"
                        invisible="diagnostic_count == 0">
                    <field name="diagnostic_count" widget="statinfo" string="Diagnostics"/>
                </button>
            </div>
        </field>
    </record>

    <record id="view_employee_form_pet_vet_hr_settings" model="ir.ui.view">
        <field name="name">hr.employee.form.pet.vet.settings</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Veterinary Performance" name="vet_performance"
                      invisible="not is_veterinarian">
                    <group>
                        <group string="Profile">
                            <field name="is_veterinarian"/>
                            <field name="vet_currency_id" invisible="1"/>
                        </group>
                        <group string="Activity">
                            <field name="appointment_count"/>
                            <field name="medical_visit_count"/>
                            <field name="inventory_items_used"/>
                        </group>
                        <group string="Revenue">
                            <field name="appointment_revenue"/>
                            <field name="avg_case_value"/>
                        </group>
                        <group string="Documentation Quality">
                            <field name="avg_case_completeness" widget="progressbar"/>
                            <field name="incomplete_case_count"/>
                            <field name="diagnostic_count"/>
                            <field name="abnormal_diagnostic_count"/>
                        </group>
                    </group>
                    <separator string="Assessment"/>
                    <field name="vet_assessment" nolabel="1" readonly="1"/>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_employee_form_pet_vet_flag" model="ir.ui.view">
        <field name="name">hr.employee.tree.pet.vet</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_tree"/>
        <field name="arch" type="xml">
            <field name="job_id" position="after">
                <field name="is_veterinarian" optional="hide"/>
            </field>
        </field>
    </record>
</odoo>
