<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pet_exam_price_config_tree" model="ir.ui.view">
        <field name="name">pet.exam.price.config.list</field>
        <field name="model">pet.exam.price.config</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="visit_type"/>
                <field name="price"/>
                <field name="currency_id" groups="base.group_multi_currency"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_pet_exam_price_config_form" model="ir.ui.view">
        <field name="name">pet.exam.price.config.form</field>
        <field name="model">pet.exam.price.config</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="visit_type"/>
                        <field name="price"/>
                        <field name="currency_id" groups="base.group_multi_currency"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pet_exam_price_config" model="ir.actions.act_window">
        <field name="name">Exam Prices</field>
        <field name="res_model">pet.exam.price.config</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_pet_exam_price_config"
              name="Exam Prices"
              parent="menu_pet_configuration"
              action="action_pet_exam_price_config"
              sequence="25"
              groups="pet_management.group_pet_configuration_user_all,pet_management.group_pet_configuration_admin"/>
</odoo>
