<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_pet_appointment_additional_invoice_wizard" model="ir.ui.view">
    <field name="name">pet.appointment.additional.invoice.wizard.form</field>
    <field name="model">pet.appointment.additional.invoice.wizard</field>
    <field name="arch" type="xml">
      <form string="Create Additional Invoice">
        <group>
          <field name="appointment_id" readonly="1"/>
          <field name="sale_order_id" readonly="1"/>
          <field name="currency_id" invisible="1"/>
          <field name="uninvoiced_amount" readonly="1"/>
          <field name="reason" placeholder="Why is an additional invoice required?"/>
        </group>
        <footer>
          <button name="action_create_additional_invoice" type="object" string="Create Invoice" class="btn-primary"/>
          <button string="Cancel" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="view_pet_billing_integrity_issue_list" model="ir.ui.view">
    <field name="name">pet.billing.integrity.issue.list</field>
    <field name="model">pet.billing.integrity.issue</field>
    <field name="arch" type="xml">
      <list>
        <field name="detected_at"/>
        <field name="severity" widget="badge"/>
        <field name="issue_type"/>
        <field name="appointment_id"/>
        <field name="name"/>
        <field name="state"/>
      </list>
    </field>
  </record>

  <record id="view_pet_billing_integrity_issue_form" model="ir.ui.view">
    <field name="name">pet.billing.integrity.issue.form</field>
    <field name="model">pet.billing.integrity.issue</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button name="action_mark_reviewed" type="object" string="Mark Reviewed" invisible="state != 'open'"/>
          <button name="action_mark_resolved" type="object" string="Mark Resolved" invisible="state == 'resolved'"/>
          <button name="action_scan_all" type="object" string="Rescan All" class="btn-secondary"/>
          <field name="state" widget="statusbar"/>
        </header>
        <sheet>
          <group>
            <field name="name"/>
            <field name="appointment_id"/>
            <field name="issue_type"/>
            <field name="severity"/>
            <field name="detected_at"/>
          </group>
          <group>
            <field name="details"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_pet_billing_integrity_issue" model="ir.actions.act_window">
    <field name="name">Billing Integrity Issues</field>
    <field name="res_model">pet.billing.integrity.issue</field>
    <field name="view_mode">list,form</field>
  </record>

  <menuitem id="menu_pet_billing_integrity"
            name="Billing Integrity"
            parent="pet_management.menu_pet_configuration"
            action="action_pet_billing_integrity_issue"
            sequence="90"
            groups="pet_management.group_pet_clinic_accountant,pet_management.group_pet_clinic_billing_manager,base.group_system"/>
</odoo>
