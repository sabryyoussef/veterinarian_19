<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="survey_question_view_form_campaign" model="ir.ui.view">
        <field name="name">survey.question.form.campaign</field>
        <field name="model">survey.question</field>
        <field name="inherit_id" ref="survey.survey_question_form"/>
        <field name="arch" type="xml">
            <field name="question_type" position="after">
                <field name="petspot_field_role"/>
            </field>
        </field>
    </record>

    <record id="survey_survey_view_form_campaign" model="ir.ui.view">
        <field name="name">survey.survey.form.campaign</field>
        <field name="model">survey.survey</field>
        <field name="inherit_id" ref="survey.survey_survey_view_form"/>
        <field name="arch" type="xml">
            <field name="title" position="after">
                <field name="petspot_campaign_step_id" readonly="1"/>
            </field>
        </field>
    </record>

</odoo>
