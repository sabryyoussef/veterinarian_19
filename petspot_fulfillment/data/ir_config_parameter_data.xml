<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
  <record id="icp_ff_automation_enabled" model="ir.config_parameter">
    <field name="key">petspot_fulfillment.automation_enabled</field>
    <field name="value">False</field>
  </record>
  <record id="icp_ff_cutover_timestamp" model="ir.config_parameter">
    <field name="key">petspot_fulfillment.cutover_timestamp</field>
    <field name="value"></field>
  </record>
  <record id="icp_ff_cw_intake_enabled" model="ir.config_parameter">
    <field name="key">petspot_fulfillment.chatwoot_intake_enabled</field>
    <field name="value">False</field>
  </record>
  <record id="icp_ff_cw_account" model="ir.config_parameter">
    <field name="key">petspot_fulfillment.chatwoot_account_id</field>
    <field name="value">2</field>
  </record>
  <record id="icp_ff_cw_inbox" model="ir.config_parameter">
    <field name="key">petspot_fulfillment.chatwoot_inbox_id</field>
    <field name="value">2</field>
  </record>
  <record id="icp_ff_cw_ack" model="ir.config_parameter">
    <field name="key">petspot_fulfillment.chatwoot_ack_enabled</field>
    <field name="value">True</field>
  </record>
  <record id="icp_ff_cw_test_mode" model="ir.config_parameter">
    <field name="key">petspot_fulfillment.chatwoot_test_mode</field>
    <field name="value">True</field>
  </record>
  <record id="icp_ff_cw_base" model="ir.config_parameter">
    <field name="key">petspot_fulfillment.chatwoot_base_url</field>
    <field name="value">http://127.0.0.1:3000</field>
  </record>
</odoo>
