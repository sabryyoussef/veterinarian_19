<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="seq_petspot_fulfillment_case" model="ir.sequence">
    <field name="name">PetSpot Fulfillment Case</field>
    <field name="code">petspot.fulfillment.case</field>
    <field name="prefix">FF/%(year)s/</field>
    <field name="padding">5</field>
  </record>
  <record id="seq_petspot_availability_inquiry" model="ir.sequence">
    <field name="name">PetSpot Availability Inquiry</field>
    <field name="code">petspot.availability.inquiry</field>
    <field name="prefix">INQ/%(year)s/</field>
    <field name="padding">5</field>
  </record>
</odoo>
