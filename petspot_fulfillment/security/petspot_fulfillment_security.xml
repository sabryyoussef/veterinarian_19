<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="module_category_petspot_fulfillment" model="ir.module.category">
    <field name="name">PetSpot Fulfillment</field>
    <field name="sequence">35</field>
  </record>

  <record id="privilege_petspot_fulfillment" model="res.groups.privilege">
    <field name="name">PetSpot Fulfillment</field>
    <field name="category_id" ref="module_category_petspot_fulfillment"/>
    <field name="sequence">35</field>
  </record>

  <record id="group_fulfillment_user" model="res.groups">
    <field name="name">User</field>
    <field name="sequence">10</field>
    <field name="privilege_id" ref="privilege_petspot_fulfillment"/>
    <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
  </record>

  <record id="group_fulfillment_purchase" model="res.groups">
    <field name="name">Purchase</field>
    <field name="sequence">15</field>
    <field name="privilege_id" ref="privilege_petspot_fulfillment"/>
    <field name="implied_ids" eval="[(4, ref('group_fulfillment_user')), (4, ref('purchase.group_purchase_user'))]"/>
  </record>

  <record id="group_fulfillment_manager" model="res.groups">
    <field name="name">Manager</field>
    <field name="sequence">20</field>
    <field name="privilege_id" ref="privilege_petspot_fulfillment"/>
    <field name="implied_ids" eval="[(4, ref('group_fulfillment_purchase')), (4, ref('sales_team.group_sale_manager'))]"/>
    <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
  </record>
</odoo>
