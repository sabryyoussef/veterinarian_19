<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_sale_order_form_petspot_ff" model="ir.ui.view">
    <field name="name">sale.order.form.petspot.fulfillment</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form"/>
    <field name="arch" type="xml">
      <xpath expr="//div[@name='button_box']" position="inside">
        <button name="action_petspot_open_fulfillment" type="object"
                class="oe_stat_button" icon="fa-truck"
                string="Fulfillment"/>
      </xpath>
      <xpath expr="//field[@name='payment_term_id']" position="after">
        <field name="petspot_fulfillment_state" readonly="1"/>
        <field name="petspot_fulfillment_path" readonly="1"/>
      </xpath>
    </field>
  </record>
</odoo>
