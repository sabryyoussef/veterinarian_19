<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_petspot_supplier_confirm_wizard" model="ir.ui.view">
    <field name="name">petspot.supplier.confirm.wizard.form</field>
    <field name="model">petspot.supplier.confirm.wizard</field>
    <field name="arch" type="xml">
      <form string="Supplier Confirmation">
        <group>
          <field name="case_id" readonly="1"/>
          <field name="available"/>
          <field name="supplier_cost"/>
          <field name="currency_id" invisible="1"/>
          <field name="supplier_eta"/>
          <field name="supplier_reference"/>
          <field name="price_changed"/>
          <field name="notes"/>
        </group>
        <footer>
          <button name="action_confirm" type="object" string="Save" class="btn-primary"/>
          <button string="Cancel" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>
