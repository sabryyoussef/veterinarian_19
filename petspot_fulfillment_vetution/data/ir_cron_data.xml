<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
  <!-- Disabled by default — a human must explicitly enable this cron. -->
  <record id="cron_vetution_data_health_snapshot" model="ir.cron">
    <field name="name">Vetution: Data Health Snapshot</field>
    <field name="model_id" ref="model_petspot_vetution_data_health"/>
    <field name="state">code</field>
    <field name="code">model.cron_take_snapshot()</field>
    <field name="interval_number">1</field>
    <field name="interval_type">hours</field>
    <field name="active" eval="False"/>
  </record>
</odoo>
