<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Append repair cron; keep noupdate so operators control active flag -->
  <data noupdate="1">
    <record id="cron_ops_activity_repair" model="ir.cron">
      <field name="name">PetSpot Vetution: Repair My Work activities</field>
      <field name="model_id" ref="model_petspot_availability_inquiry"/>
      <field name="state">code</field>
      <field name="code">model.cron_petspot_ops_repair_activities()</field>
      <field name="interval_number">6</field>
      <field name="interval_type">hours</field>
      <field name="active" eval="False"/>
    </record>
  </data>
</odoo>
