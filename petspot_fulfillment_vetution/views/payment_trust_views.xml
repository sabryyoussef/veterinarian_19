<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_payment_trust_form" model="ir.ui.view">
    <field name="name">petspot.vetution.payment.trust.form</field>
    <field name="model">petspot.vetution.payment.trust</field>
    <field name="arch" type="xml">
      <form string="Payment Trust Record">
        <sheet>
          <group>
            <group>
              <field name="case_id"/>
              <field name="inquiry_id"/>
              <field name="source"/>
              <field name="state"/>
              <field name="reject_reason"/>
            </group>
            <group>
              <field name="amount"/>
              <field name="currency"/>
              <field name="reference"/>
              <field name="approved_by"/>
              <field name="payload_hash"/>
            </group>
          </group>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>
  <record id="view_payment_trust_list" model="ir.ui.view">
    <field name="name">petspot.vetution.payment.trust.list</field>
    <field name="model">petspot.vetution.payment.trust</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="case_id"/>
        <field name="source"/>
        <field name="amount"/>
        <field name="currency"/>
        <field name="reference"/>
        <field name="state"/>
      </list>
    </field>
  </record>
  <record id="action_payment_trust" model="ir.actions.act_window">
    <field name="name">Payment Trust</field>
    <field name="res_model">petspot.vetution.payment.trust</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
