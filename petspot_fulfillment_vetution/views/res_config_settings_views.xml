<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="res_config_settings_view_form_petspot_ops" model="ir.ui.view">
    <field name="name">res.config.settings.view.form.petspot.ops</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="base.res_config_settings_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//form" position="inside">
        <app string="PetSpot Ops Owners" name="petspot_fulfillment_vetution_ops"
             groups="petspot_fulfillment.group_fulfillment_manager">
          <block title="My Work activity owners">
            <setting string="Product Mapping" help="Receives MAPPING_REQUIRED activities">
              <field name="petspot_ops_owner_product_id"/>
            </setting>
            <setting string="Purchasing">
              <field name="petspot_ops_owner_purchasing_id"/>
            </setting>
            <setting string="Finance / Payment">
              <field name="petspot_ops_owner_finance_id"/>
            </setting>
            <setting string="Sales / Customer Service">
              <field name="petspot_ops_owner_sales_id"/>
            </setting>
            <setting string="Shipping">
              <field name="petspot_ops_owner_shipping_id"/>
            </setting>
            <setting string="Giza Warehouse">
              <field name="petspot_ops_owner_warehouse_id"/>
            </setting>
            <setting string="Store Pickup">
              <field name="petspot_ops_owner_store_id"/>
            </setting>
            <setting string="Fulfillment Manager / Escalation">
              <field name="petspot_ops_owner_manager_id"/>
            </setting>
          </block>
        </app>
      </xpath>
    </field>
  </record>
</odoo>
