<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_shadow_assessment_form" model="ir.ui.view">
    <field name="name">petspot.vetution.shadow.assessment.form</field>
    <field name="model">petspot.vetution.shadow.assessment</field>
    <field name="arch" type="xml">
      <form create="0">
        <header>
          <field name="state" widget="statusbar"/>
        </header>
        <sheet>
          <div class="alert alert-warning" role="alert">
            Phase 15A.4 shadow only — product price excludes delivery revenue; no quote, message, price publish, PO, or AWB.
          </div>
          <group>
            <group>
              <field name="name"/>
              <field name="inquiry_id"/>
              <field name="product_id"/>
              <field name="case_id"/>
              <field name="active"/>
              <field name="assessed_at"/>
              <field name="legacy_combined_cost_model"/>
            </group>
            <group>
              <field name="resolution_method"/>
              <field name="resolution_confidence"/>
              <field name="vetution_drug_id"/>
              <field name="vetution_size_id"/>
              <field name="drug_slug"/>
              <field name="mapping_review_id"/>
            </group>
          </group>
          <group string="Freshness / availability">
            <field name="snapshot_id"/>
            <field name="availability_normalized"/>
            <field name="source_sync_at"/>
            <field name="data_age_hours"/>
            <field name="is_fresh"/>
            <field name="refresh_attempted"/>
            <field name="refresh_succeeded"/>
            <field name="eta_days"/>
          </group>
          <group string="Product economics">
            <field name="policy_id"/>
            <field name="policy_version"/>
            <field name="supplier_cost"/>
            <field name="component_delivery"/>
            <field name="component_payment_fee"/>
            <field name="component_packaging"/>
            <field name="component_nonrecoverable_tax"/>
            <field name="component_risk_allowance"/>
            <field name="component_handling"/>
            <field name="product_landed_cost"/>
            <field name="landed_cost"/>
            <field name="recommended_product_price"/>
            <field name="suggested_price"/>
            <field name="expected_gross_profit"/>
            <field name="expected_gross_margin_percent"/>
            <field name="product_cost_completeness"/>
            <field name="product_decision_code"/>
            <field name="sell_formula"/>
            <field name="landed_formula"/>
          </group>
          <group string="Delivery economics (order-level)">
            <field name="economics_scenario"/>
            <field name="customer_delivery_charge"/>
            <field name="estimated_carrier_cost"/>
            <field name="component_shipblu_shipping"/>
            <field name="delivery_specific_fees"/>
            <field name="component_cod_commission"/>
            <field name="delivery_margin"/>
            <field name="delivery_subsidy"/>
            <field name="delivery_cost_completeness"/>
            <field name="delivery_decision_code"/>
            <field name="economics_evidence_source"/>
          </group>
          <group string="Order summary">
            <field name="recommended_product_price"/>
            <field name="customer_delivery_charge"/>
            <field name="order_total"/>
            <field name="overall_completeness"/>
            <field name="completeness_percent"/>
            <field name="pricing_confidence_percent"/>
            <field name="pricing_confidence_label"/>
            <field name="decision_code"/>
            <field name="landed_cost_incomplete"/>
            <field name="missing_cost_components"/>
            <field name="estimate_cost_components"/>
            <field name="landed_cost_report" colspan="2" nolabel="1"/>
          </group>
          <group string="Catalog / gates (unchanged)">
            <field name="price_review_required"/>
            <field name="on_automation_allowlist"/>
            <field name="availability_wording"/>
            <field name="eligible_future_automation"/>
            <field name="gate_block_auto_quotation"/>
            <field name="gate_block_odoo_price_update"/>
            <field name="gate_block_shopify_publish"/>
            <field name="gate_block_supplier_purchase"/>
            <field name="quotation_validity_hours"/>
            <field name="current_odoo_price"/>
            <field name="current_shopify_price"/>
            <field name="price_delta_amount"/>
            <field name="price_delta_percent"/>
          </group>
          <group string="Decision">
            <field name="blockers"/>
            <field name="recommended_next_action"/>
            <field name="payload_hash"/>
            <field name="note"/>
          </group>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>
  <record id="view_shadow_assessment_list" model="ir.ui.view">
    <field name="name">petspot.vetution.shadow.assessment.list</field>
    <field name="model">petspot.vetution.shadow.assessment</field>
    <field name="arch" type="xml">
      <list>
        <field name="active"/>
        <field name="name"/>
        <field name="inquiry_id"/>
        <field name="product_id"/>
        <field name="state"/>
        <field name="availability_normalized"/>
        <field name="recommended_product_price"/>
        <field name="customer_delivery_charge"/>
        <field name="order_total"/>
        <field name="decision_code"/>
        <field name="product_decision_code"/>
        <field name="delivery_decision_code"/>
        <field name="is_fresh"/>
        <field name="assessed_at"/>
      </list>
    </field>
  </record>
  <record id="action_shadow_assessment" model="ir.actions.act_window">
    <field name="name">Shadow Assessments</field>
    <field name="res_model">petspot.vetution.shadow.assessment</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
