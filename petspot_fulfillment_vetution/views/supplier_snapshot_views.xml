<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_supplier_snapshot_form" model="ir.ui.view">
    <field name="name">petspot.vetution.supplier.snapshot.form</field>
    <field name="model">petspot.vetution.supplier.snapshot</field>
    <field name="arch" type="xml">
      <form create="0" delete="0">
        <sheet>
          <group>
            <group>
              <field name="name"/>
              <field name="assessment_id"/>
              <field name="inquiry_id"/>
              <field name="offer_id"/>
              <field name="payload_hash"/>
              <field name="schema_version"/>
            </group>
            <group>
              <field name="vetution_drug_id"/>
              <field name="vetution_size_id"/>
              <field name="drug_slug"/>
              <field name="size_name"/>
              <field name="supplier_sku"/>
              <field name="barcode"/>
              <field name="resolution_confidence"/>
            </group>
          </group>
          <group string="Commercial (sanitized)">
            <field name="purchase_price"/>
            <field name="public_list_price"/>
            <field name="availability_raw"/>
            <field name="availability_normalized"/>
            <field name="supplier_qty"/>
            <field name="offer_expiry_date"/>
            <field name="offer_is_expired"/>
            <field name="source_sync_at"/>
            <field name="assessed_at"/>
          </group>
          <group>
            <field name="sanitized_summary" colspan="2" nolabel="1"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>
  <record id="view_supplier_snapshot_list" model="ir.ui.view">
    <field name="name">petspot.vetution.supplier.snapshot.list</field>
    <field name="model">petspot.vetution.supplier.snapshot</field>
    <field name="arch" type="xml">
      <list create="0" delete="0">
        <field name="name"/>
        <field name="vetution_size_id"/>
        <field name="availability_normalized"/>
        <field name="purchase_price"/>
        <field name="source_sync_at"/>
        <field name="assessed_at"/>
        <field name="payload_hash"/>
      </list>
    </field>
  </record>
  <record id="action_supplier_snapshot" model="ir.actions.act_window">
    <field name="name">Supplier Snapshots</field>
    <field name="res_model">petspot.vetution.supplier.snapshot</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
