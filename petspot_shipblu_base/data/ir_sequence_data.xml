<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_shipblu_shipment" model="ir.sequence">
        <field name="name">ShipBlu Shipment</field>
        <field name="code">shipblu.shipment</field>
        <field name="prefix">SB-</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_shipblu_settlement" model="ir.sequence">
        <field name="name">ShipBlu Settlement</field>
        <field name="code">shipblu.settlement</field>
        <field name="prefix">SET-</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_shipblu_pickup_batch" model="ir.sequence">
        <field name="name">ShipBlu Pickup Batch</field>
        <field name="code">shipblu.pickup.batch</field>
        <field name="prefix">PKB-</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
