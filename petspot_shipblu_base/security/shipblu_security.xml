<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_shipblu" model="ir.module.category">
        <field name="name">ShipBlu Shipping</field>
        <field name="sequence">41</field>
    </record>
    <record id="privilege_shipblu" model="res.groups.privilege">
        <field name="name">ShipBlu Shipping</field>
        <field name="category_id" ref="module_category_shipblu"/>
        <field name="sequence">41</field>
    </record>
    <record id="group_shipblu_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_shipblu"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_shipblu_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_shipblu"/>
        <field name="implied_ids" eval="[(4, ref('group_shipblu_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
    <record id="shipblu_backend_company_rule" model="ir.rule">
        <field name="name">ShipBlu backend multi-company</field>
        <field name="model_id" ref="model_shipblu_backend"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="shipblu_api_log_company_rule" model="ir.rule">
        <field name="name">ShipBlu API log multi-company</field>
        <field name="model_id" ref="model_shipblu_api_log"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
