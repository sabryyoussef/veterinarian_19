<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_shipblu_api_log_tree" model="ir.ui.view">
        <field name="name">shipblu.api.log.list</field>
        <field name="model">shipblu.api.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0">
                <field name="create_date"/>
                <field name="method"/>
                <field name="http_status"/>
                <field name="duration_ms"/>
                <field name="url"/>
                <field name="error_message"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>
    <record id="view_shipblu_api_log_form" model="ir.ui.view">
        <field name="name">shipblu.api.log.form</field>
        <field name="model">shipblu.api.log</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <sheet>
                    <group>
                        <field name="backend_id"/>
                        <field name="company_id"/>
                        <field name="method"/>
                        <field name="http_status"/>
                        <field name="duration_ms"/>
                        <field name="url"/>
                        <field name="error_message"/>
                    </group>
                    <group string="Bodies">
                        <field name="request_headers" widget="text"/>
                        <field name="request_body" widget="text"/>
                        <field name="response_body" widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_shipblu_api_log" model="ir.actions.act_window">
        <field name="name">ShipBlu API Logs</field>
        <field name="res_model">shipblu.api.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
