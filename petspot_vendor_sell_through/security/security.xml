<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_vendor_sell_through" model="ir.module.category">
        <field name="name">Vendor Sell-Through</field>
        <field name="sequence">56</field>
    </record>

    <record model="res.groups.privilege" id="privilege_vendor_sell_through">
        <field name="name">Vendor Sell-Through</field>
        <field name="sequence">56</field>
        <field name="category_id" ref="module_category_vendor_sell_through"/>
    </record>

    <record id="group_vst_viewer" model="res.groups">
        <field name="name">Sell-through viewer</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_vendor_sell_through"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_vst_allocation_manager" model="res.groups">
        <field name="name">Inventory allocation manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_vendor_sell_through"/>
        <field name="implied_ids" eval="[(4, ref('group_vst_viewer')), (4, ref('stock.group_stock_user'))]"/>
    </record>

    <record id="group_vst_payment_manager" model="res.groups">
        <field name="name">Accounting payment manager</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="privilege_vendor_sell_through"/>
        <field name="implied_ids" eval="[(4, ref('group_vst_viewer')), (4, ref('account.group_account_invoice'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
