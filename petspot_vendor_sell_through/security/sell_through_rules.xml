    <record id="vst_commercial_source_company_rule" model="ir.rule">
        <field name="name">VST commercial source multi-company</field>
        <field name="model_id" ref="model_petspot_vendor_sell_through_commercial_source"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
