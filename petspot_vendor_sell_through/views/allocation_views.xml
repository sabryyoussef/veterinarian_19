<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vst_allocation_list" model="ir.ui.view">
        <field name="name">petspot.vendor.sell.through.allocation.list</field>
        <field name="model">petspot.vendor.sell.through.allocation</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="vendor_bill_id"/>
                <field name="product_id"/>
                <field name="qty_base"/>
                <field name="status"/>
                <field name="source_kind"/>
                <field name="is_return"/>
                <field name="outgoing_picking_id"/>
                <field name="customer_invoice_id" optional="show"/>
                <field name="partner_display_masked"/>
                <field name="evidence_ref" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_vst_allocation_form" model="ir.ui.view">
        <field name="name">petspot.vendor.sell.through.allocation.form</field>
        <field name="model">petspot.vendor.sell.through.allocation</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="vendor_bill_id"/>
                        <field name="layer_id"/>
                        <field name="product_id"/>
                        <field name="qty_base"/>
                        <field name="status"/>
                        <field name="source_kind"/>
                        <field name="is_return"/>
                        <field name="outgoing_picking_id"/>
                        <field name="customer_invoice_id"/>
                        <field name="customer_invoice_line_id"/>
                        <field name="commercial_source_id"/>
                        <field name="sale_order_line_id"/>
                        <field name="source_key"/>
                        <field name="evidence_ref"/>
                        <field name="reason"/>
                        <field name="approved_by_id"/>
                        <field name="approved_date"/>
                        <field name="partner_display_masked"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_vst_allocation" model="ir.actions.act_window">
        <field name="name">Sell-Through Allocations</field>
        <field name="res_model">petspot.vendor.sell.through.allocation</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
