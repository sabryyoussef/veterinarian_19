<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vst_layer_list" model="ir.ui.view">
        <field name="name">petspot.vendor.sell.through.layer.list</field>
        <field name="model">petspot.vendor.sell.through.layer</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="vendor_bill_id"/>
                <field name="product_id"/>
                <field name="lot_id" optional="show"/>
                <field name="received_qty_base"/>
                <field name="allocated_sold_qty_base"/>
                <field name="remaining_qty_base"/>
                <field name="unit_cost_base"/>
                <field name="confidence"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="view_vst_layer_form" model="ir.ui.view">
        <field name="name">petspot.vendor.sell.through.layer.form</field>
        <field name="model">petspot.vendor.sell.through.layer</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="vendor_bill_id"/>
                            <field name="vendor_bill_line_id"/>
                            <field name="product_id"/>
                            <field name="lot_id"/>
                            <field name="confidence"/>
                        </group>
                        <group>
                            <field name="received_qty_base"/>
                            <field name="allocated_sold_qty_base"/>
                            <field name="customer_return_qty_base"/>
                            <field name="remaining_qty_base"/>
                            <field name="unit_cost_base"/>
                            <field name="currency_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_vst_layer" model="ir.actions.act_window">
        <field name="name">Sell-Through Layers</field>
        <field name="res_model">petspot.vendor.sell.through.layer</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
