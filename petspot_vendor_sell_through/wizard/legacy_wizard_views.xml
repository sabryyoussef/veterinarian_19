<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vst_legacy_wizard_form" model="ir.ui.view">
        <field name="name">petspot.vendor.sell.through.legacy.wizard.form</field>
        <field name="model">petspot.vendor.sell.through.legacy.wizard</field>
        <field name="arch" type="xml">
            <form string="Legacy Sell-Through Allocation">
                <group>
                    <field name="vendor_bill_id"/>
                    <field name="vendor_bill_line_id"/>
                    <field name="product_id"/>
                    <field name="qty"/>
                    <field name="uom_id"/>
                    <field name="sale_order_ids" widget="many2many_tags"/>
                    <field name="invoice_ids" widget="many2many_tags"/>
                    <field name="evidence_ref"/>
                    <field name="reason"/>
                    <field name="approve"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Create allocation" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
