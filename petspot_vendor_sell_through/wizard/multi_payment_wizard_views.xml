<odoo>
    <record id="view_vst_multi_payment_wizard_form" model="ir.ui.view">
        <field name="name">petspot.vendor.sell.through.multi.payment.wizard.form</field>
        <field name="model">petspot.vendor.sell.through.multi.payment.wizard</field>
        <field name="arch" type="xml">
            <form string="Register Combined Sell-Through Payment / تسجيل دفعة مجمعة حسب المنتجات المباعة">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        Opening this wizard does not create or post a payment.
                        Manual UAT must leave "Post payment now" unchecked.
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id"/>
                            <field name="payment_date"/>
                            <field name="journal_id"/>
                            <field name="payment_method_line_id"/>
                            <field name="memo"/>
                            <field name="idempotency_key" readonly="1"/>
                        </group>
                        <group>
                            <field name="combined_amount"/>
                            <field name="confirm_post" groups="base.group_no_one"/>
                            <field name="snapshot_json" invisible="1"/>
                            <field name="available_payment_method_line_ids" invisible="1"/>
                        </group>
                    </group>
                    <field name="warning_html" nolabel="1" invisible="not warning_html"/>
                    <field name="line_ids">
                        <list editable="bottom" create="0" delete="0">
                            <field name="move_id"/>
                            <field name="bill_date"/>
                            <field name="due_date"/>
                            <field name="bill_total"/>
                            <field name="residual"/>
                            <field name="eligible_amount"/>
                            <field name="already_paid"/>
                            <field name="payment_cap"/>
                            <field name="allocation_amount" sum="Combined"/>
                            <field name="residual_after"/>
                            <field name="confidence"/>
                            <field name="blocking_warning"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_refresh_caps" type="object" string="Refresh caps" class="btn-secondary"/>
                    <button name="action_confirm" type="object" string="Confirm / Review payment" class="btn-primary"
                            groups="petspot_vendor_sell_through.group_vst_payment_manager"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_vst_multi_payment_log_list" model="ir.ui.view">
        <field name="name">petspot.vendor.sell.through.multi.payment.log.list</field>
        <field name="model">petspot.vendor.sell.through.multi.payment.log</field>
        <field name="arch" type="xml">
            <list create="0" delete="0">
                <field name="timestamp"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="payment_amount"/>
                <field name="payment_id"/>
                <field name="drift_rejected"/>
                <field name="user_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="action_vst_multi_payment_log" model="ir.actions.act_window">
        <field name="name">Combined Payment Audit</field>
        <field name="res_model">petspot.vendor.sell.through.multi.payment.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
