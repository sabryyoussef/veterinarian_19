<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vst_payment_wizard_form" model="ir.ui.view">
        <field name="name">view_vst_payment_wizard_form</field>
        <field name="model">petspot.vendor.sell.through.payment.wizard</field>
        <field name="arch" type="xml">
<form string="Register Sell-Through Payment / دفع قيمة المنتجات المباعة">
                <div class="alert alert-warning" role="alert" invisible="not rebuild_recommended">
                    Sell-through data may need a rebuild by an Inventory allocation manager.
                    This wizard only reads existing eligible amounts and does not rebuild or delete allocations.
                </div>
                <group>
                    <field name="move_id"/>
                    <field name="last_recalculation"/>
                    <field name="rebuild_recommended" invisible="1"/>
                    <field name="eligible_amount"/>
                    <field name="already_paid"/>
                    <field name="residual"/>
                    <field name="suggested_amount"/>
                    <field name="amount"/>
                    <field name="journal_id"/>
                    <field name="company_id" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="confirm_post" groups="base.group_no_one"/>
                </group>
                <footer>
                    <button name="action_open_standard_payment" type="object" string="Review &amp; open payment" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
