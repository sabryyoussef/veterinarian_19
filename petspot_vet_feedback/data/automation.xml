<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="automation_vet_feedback_on_complete" model="base.automation">
            <field name="name">Send Vet Feedback Survey on Case Complete</field>
            <field name="model_id" ref="pet_management.model_pet_medical_visit"/>
            <field name="trigger">on_create_or_write</field>
            <field name="filter_domain">[('status', '=', 'completed'), ('feedback_request_sent', '=', False)]</field>
            <field name="action_server_ids" eval="[(0, 0, {
                'name': 'Send Vet Feedback Survey',
                'model_id': ref('pet_management.model_pet_medical_visit'),
                'state': 'code',
                'code': 'records._send_vet_feedback_request()',
            })]"/>
        </record>

    </data>
</odoo>
