<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pet_vet_performance_list_feedback" model="ir.ui.view">
        <field name="name">pet.vet.performance.report.list.feedback</field>
        <field name="model">pet.vet.performance.report</field>
        <field name="inherit_id" ref="pet_management.view_pet_vet_performance_list"/>
        <field name="arch" type="xml">
            <field name="case_completeness_pct" position="after">
                <field name="feedback_rating" optional="show"/>
            </field>
        </field>
    </record>

    <record id="view_pet_vet_performance_pivot_feedback" model="ir.ui.view">
        <field name="name">pet.vet.performance.report.pivot.feedback</field>
        <field name="model">pet.vet.performance.report</field>
        <field name="inherit_id" ref="pet_management.view_pet_vet_performance_pivot"/>
        <field name="arch" type="xml">
            <field name="case_completeness_pct" position="after">
                <field name="feedback_rating" type="measure"/>
            </field>
        </field>
    </record>
</odoo>
