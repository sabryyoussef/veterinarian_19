<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_petspot_shop" model="ir.ui.view">
        <field name="name">product.template.petspot.shop</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="PetSpot Shop" name="petspot_shop" invisible="not vetution_id">
                    <group>
                        <field name="petspot_shop_has_sellable"/>
                        <field name="petspot_shop_min_sellable_price"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
