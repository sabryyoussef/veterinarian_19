<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_petspot_wa_consent" model="ir.module.category">
        <field name="name">Pet Spot WA Consent</field>
        <field name="sequence">45</field>
    </record>
    <record id="privilege_wa_consent" model="res.groups.privilege">
        <field name="name">WA Marketing Consent</field>
        <field name="category_id" ref="module_category_petspot_wa_consent"/>
        <field name="sequence">45</field>
    </record>
    <record id="group_wa_consent_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_wa_consent"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_wa_consent_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_wa_consent"/>
        <field name="implied_ids" eval="[(4, ref('group_wa_consent_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
