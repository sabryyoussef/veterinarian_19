<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mkt_audience_tree" model="ir.ui.view">
        <field name="name">petspot.wa.marketing.audience.list</field>
        <field name="model">petspot.wa.marketing.audience</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="resolved_at"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_mkt_audience_form" model="ir.ui.view">
        <field name="name">petspot.wa.marketing.audience.form</field>
        <field name="model">petspot.wa.marketing.audience</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_resolve" type="object" string="Resolve Tags" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="active"/>
                        <field name="resolved_at" readonly="1"/>
                    </group>
                    <group string="Required tag names (exact; not domain values)">
                        <field name="required_tag_names_json" widget="text"/>
                    </group>
                    <group string="Resolved (IDs)">
                        <field name="partner_domain" readonly="1"/>
                        <field name="resolved_tags_json" readonly="1" widget="text"/>
                        <field name="rename_warnings_json" readonly="1" widget="text"/>
                        <field name="resolve_error" readonly="1" widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_mkt_audience" model="ir.actions.act_window">
        <field name="name">Marketing Audiences</field>
        <field name="res_model">petspot.wa.marketing.audience</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
