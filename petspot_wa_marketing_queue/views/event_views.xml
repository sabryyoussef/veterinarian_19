<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mkt_event_tree" model="ir.ui.view">
        <field name="name">petspot.wa.marketing.event.list</field>
        <field name="model">petspot.wa.marketing.event</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" edit="0">
                <field name="create_date"/>
                <field name="event_type"/>
                <field name="campaign_id"/>
                <field name="partner_id"/>
                <field name="mobile_normalized"/>
                <field name="note"/>
                <field name="operator_id"/>
            </list>
        </field>
    </record>
    <record id="action_mkt_event" model="ir.actions.act_window">
        <field name="name">Marketing Audit Events</field>
        <field name="res_model">petspot.wa.marketing.event</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
