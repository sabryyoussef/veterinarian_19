<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bank_sms_backfill_wizard_form" model="ir.ui.view">
        <field name="name">bank.sms.backfill.wizard.form</field>
        <field name="model">bank.sms.backfill.wizard</field>
        <field name="arch" type="xml">
            <form string="Backfill Counterparty Mappings">
                <group>
                    <field name="state" widget="statusbar"/>
                    <field name="result_summary" nolabel="1"
                           placeholder="Run Dry-Run Preview before applying changes."/>
                </group>
                <group invisible="state == 'draft'" col="5">
                    <field name="total_count"/>
                    <field name="changed_count"/>
                    <field name="mapped_count"/>
                    <field name="unmapped_count"/>
                    <field name="conflict_count"/>
                </group>
                <footer>
                    <button name="action_preview" type="object"
                            string="Dry-Run Preview" class="btn-secondary"/>
                    <button name="action_apply" type="object"
                            string="Apply Backfill" class="btn-primary"
                            invisible="state != 'preview' or conflict_count"/>
                    <button string="Close" special="cancel" class="btn-link"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_bank_sms_backfill_wizard" model="ir.actions.act_window">
        <field name="name">Backfill Counterparty Mappings</field>
        <field name="res_model">bank.sms.backfill.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
