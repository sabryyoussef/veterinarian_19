<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List — amount, sender/receiver, running balance for calculations -->
    <record id="view_bank_sms_transaction_list" model="ir.ui.view">
        <field name="name">bank.sms.transaction.list</field>
        <field name="model">bank.sms.transaction</field>
        <field name="arch" type="xml">
            <list string="Bank Transactions" decoration-success="direction=='in'"
                  decoration-danger="direction=='out'" sample="1"
                  multi_edit="1">
                <field name="date"/>
                <field name="direction"/>
                <field name="txn_type" optional="hide"/>
                <field name="counterparty_display" string="Counterparty"/>
                <field name="real_counterparty_name" optional="hide"/>
                <field name="masked_counterparty_name" optional="hide"/>
                <field name="mapping_state" widget="badge" optional="show"/>
                <field name="amount" sum="Total Amount"/>
                <field name="signed_amount" sum="Net (+/−)" optional="hide"/>
                <field name="running_balance" string="Balance" optional="show"/>
                <field name="expense_category_id" string="Expense Category"
                         optional="show"/>
                <field name="expense_id" optional="show"/>
                <field name="expense_state" optional="hide" widget="badge"/>
                <field name="bank_balance" string="Bank Balance" optional="hide"/>
                <field name="account_last4" optional="hide"/>
                <field name="ref" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Form -->
    <record id="view_bank_sms_transaction_form" model="ir.ui.view">
        <field name="name">bank.sms.transaction.form</field>
        <field name="model">bank.sms.transaction</field>
        <field name="arch" type="xml">
            <form string="Bank Transaction">
                <header>
                    <button name="action_create_update_mapping" type="object"
                            string="Create/Update Mapping"
                            class="btn-secondary"
                            groups="base.group_system"/>
                    <button name="action_create_expense" type="object" string="Create Expense"
                            class="btn-primary"
                            invisible="direction != 'out' or expense_id"/>
                    <button name="action_open_expense" type="object" string="Open Expense"
                            invisible="not expense_id"/>
                    <field name="expense_state" widget="statusbar"
                            invisible="not expense_id"
                            statusbar_visible="draft,submitted,approved,posted,paid"/>
                </header>
                <sheet>
                    <group>
                        <group string="Transaction">
                            <field name="date"/>
                            <field name="direction"/>
                            <field name="txn_type"/>
                            <field name="amount"/>
                            <field name="signed_amount"/>
                            <field name="currency_id"/>
                        </group>
                        <group string="Parties &amp; Balance">
                            <field name="counterparty_display" readonly="1"/>
                            <field name="real_counterparty_name"/>
                            <field name="masked_counterparty_name" readonly="1"/>
                            <field name="mapping_state" widget="badge" readonly="1"/>
                            <field name="mapping_conflict"
                                   invisible="mapping_state != 'conflict'"
                                   readonly="1"/>
                            <field name="counterparty_mapping_id" readonly="1"/>
                            <field name="counterparty" invisible="1" readonly="1"/>
                            <field name="partner_id"/>
                            <field name="running_balance"/>
                            <field name="bank_balance"/>
                            <field name="ref"/>
                            <field name="account_last4"/>
                            <field name="sms_log_id"/>
                        </group>
                    </group>
                    <group string="Expense" invisible="direction != 'out'">
                        <field name="expense_category_id"
                                 options="{'no_create': False}"/>
                        <field name="expense_id" readonly="1"/>
                    </group>
                    <group string="Original Message">
                        <field name="body" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search / filters / group by -->
    <record id="view_bank_sms_transaction_search" model="ir.ui.view">
        <field name="name">bank.sms.transaction.search</field>
        <field name="model">bank.sms.transaction</field>
        <field name="arch" type="xml">
            <search string="Bank Transactions">
                <field name="counterparty_display" string="Counterparty"/>
                <field name="real_counterparty_name"/>
                <field name="masked_counterparty_name"/>
                <field name="ref"/>
                <field name="account_last4"/>
                <field name="body"/>
                <separator/>
                <filter name="incoming" string="Incoming (Received)" domain="[('direction','=','in')]"/>
                <filter name="outgoing" string="Outgoing (Sent)" domain="[('direction','=','out')]"/>
                <separator/>
                <filter name="no_expense" string="No Expense Yet"
                        domain="[('direction','=','out'),('expense_id','=',False)]"/>
                <filter name="with_expense" string="Linked to Expense"
                        domain="[('expense_id','!=',False)]"/>
                <filter name="no_category" string="No Category"
                        domain="[('direction','=','out'),('expense_category_id','=',False)]"/>
                <separator/>
                <filter name="mapped" string="Mapped"
                        domain="[('mapping_state','=','mapped')]"/>
                <filter name="unmapped" string="Unmapped"
                        domain="[('mapping_state','=','unmapped')]"/>
                <filter name="mapping_conflict" string="Mapping Conflict"
                        domain="[('mapping_state','=','conflict')]"/>
                <separator/>
                <filter name="transfers" string="Transfers" domain="[('txn_type','=','transfer')]"/>
                <filter name="cards" string="Card / Debit" domain="[('txn_type','=','card')]"/>
                <separator/>
                <filter name="this_month" string="This Month"
                        domain="[('date','&gt;=', (context_today().strftime('%Y-%m-01')))]"/>
                <group>
                    <filter name="gb_direction" string="Direction" context="{'group_by':'direction'}"/>
                    <filter name="gb_type" string="Type" context="{'group_by':'txn_type'}"/>
                    <filter name="gb_category" string="Expense Category" context="{'group_by':'expense_category_id'}"/>
                    <filter name="gb_real_counterparty" string="Real Name"
                            context="{'group_by':'real_counterparty_name'}"/>
                    <filter name="gb_masked_counterparty" string="Masked Name"
                            context="{'group_by':'masked_counterparty_name'}"/>
                    <filter name="gb_mapping_state" string="Mapped / Unmapped"
                            context="{'group_by':'mapping_state'}"/>
                    <filter name="gb_account" string="Account" context="{'group_by':'account_last4'}"/>
                    <filter name="gb_month" string="Month" context="{'group_by':'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Pivot (cashflow report) -->
    <record id="view_bank_sms_transaction_pivot" model="ir.ui.view">
        <field name="name">bank.sms.transaction.pivot</field>
        <field name="model">bank.sms.transaction</field>
        <field name="arch" type="xml">
            <pivot string="Cashflow" sample="1">
                <field name="date" interval="month" type="row"/>
                <field name="real_counterparty_name" type="row"/>
                <field name="masked_counterparty_name" type="row"/>
                <field name="direction" type="col"/>
                <field name="amount" type="measure"/>
                <field name="signed_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Graph -->
    <record id="view_bank_sms_transaction_graph" model="ir.ui.view">
        <field name="name">bank.sms.transaction.graph</field>
        <field name="model">bank.sms.transaction</field>
        <field name="arch" type="xml">
            <graph string="Cashflow" sample="1" type="bar">
                <field name="date" interval="month"/>
                <field name="signed_amount" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Action: Transactions (default view for the app) -->
    <record id="action_bank_sms_transaction" model="ir.actions.act_window">
        <field name="name">Bank Transactions</field>
        <field name="res_model">bank.sms.transaction</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="search_view_id" ref="view_bank_sms_transaction_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No bank transactions yet</p>
            <p>Amount and Sender/Receiver are extracted from bank SMS automatically.
               Use the Balance column to track your running balance.</p>
        </field>
    </record>

    <!-- Action: Analysis (report-first) -->
    <record id="action_bank_sms_transaction_report" model="ir.actions.act_window">
        <field name="name">Cashflow Analysis</field>
        <field name="res_model">bank.sms.transaction</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="view_bank_sms_transaction_search"/>
    </record>

    <!-- Server action: Sync from SMS -->
    <record id="action_bank_sms_sync" model="ir.actions.server">
        <field name="name">Sync Transactions from SMS</field>
        <field name="model_id" ref="model_bank_sms_transaction"/>
        <field name="binding_model_id" ref="model_bank_sms_transaction"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = model.action_sync_from_logs()</field>
    </record>

    <!-- Apply default expense categories -->
    <record id="action_bank_sms_suggest_category" model="ir.actions.server">
        <field name="name">Suggest Expense Categories</field>
        <field name="model_id" ref="model_bank_sms_transaction"/>
        <field name="binding_model_id" ref="model_bank_sms_transaction"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_suggest_category()</field>
    </record>

    <!-- Create expenses in Expenses app -->
    <record id="action_bank_sms_create_expense" model="ir.actions.server">
        <field name="name">Create Expenses</field>
        <field name="model_id" ref="model_bank_sms_transaction"/>
        <field name="binding_model_id" ref="model_bank_sms_transaction"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">action = records.action_create_expense()</field>
    </record>

</odoo>
