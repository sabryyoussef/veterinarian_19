<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_sms_form" model="ir.ui.view">
        <field name="name">res.partner.sms.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_sms_messages"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-commenting-o"
                        invisible="not id">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value"><field name="sms_message_count"/></span>
                        <span class="o_stat_text">SMS</span>
                    </div>
                </button>
                <button name="action_send_sms_message"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-paper-plane"
                        string="Send SMS"
                        invisible="not id"/>
            </div>
        </field>
    </record>
</odoo>
