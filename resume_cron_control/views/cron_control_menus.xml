<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_resume_cron_control" model="ir.actions.act_window">
        <field name="name">Cron jobs</field>
        <field name="res_model">ir.cron</field>
        <field name="path">cron-control</field>
        <field name="view_mode">list,form,calendar</field>
        <field name="context">{'search_default_all': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No scheduled actions are defined yet.
            </p>
            <p>
                Scheduled actions are created when you install apps (Mail, CRM, custom modules, etc.).
                Use this screen to turn jobs on or off and change how often they run.
            </p>
        </field>
    </record>

    <!-- Top-level app: only full Settings admins (same ACL as ir.cron) -->
    <menuitem id="menu_resume_cron_root"
              name="Cron Control"
              sequence="25"
              web_icon="base,static/description/settings.png"
              groups="base.group_system"/>

    <menuitem id="menu_resume_cron_jobs"
              name="Scheduled jobs"
              parent="menu_resume_cron_root"
              action="action_resume_cron_control"
              sequence="10"/>

    <menuitem id="menu_resume_cron_analytics"
              name="Results &amp; analytics"
              parent="menu_resume_cron_root"
              action="action_resume_cron_analytics"
              sequence="20"/>
</odoo>
