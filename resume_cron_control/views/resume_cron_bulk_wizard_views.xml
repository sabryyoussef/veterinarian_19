<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_resume_cron_bulk_wizard_form" model="ir.ui.view">
        <field name="name">resume.cron.bulk.wizard.form</field>
        <field name="model">resume.cron.bulk.wizard</field>
        <field name="arch" type="xml">
            <form string="Bulk cron control">
                <group>
                    <field name="operation" widget="radio"/>
                </group>
                <group invisible="operation != 'interval'">
                    <label for="interval_number" string="Execute every"/>
                    <div class="o_row">
                        <field name="interval_number" class="oe_inline"/>
                        <field name="interval_type" class="oe_inline"/>
                    </div>
                </group>
                <group>
                    <field name="cron_ids" widget="many2many_tags" options="{'no_create': True}"/>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Apply" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
