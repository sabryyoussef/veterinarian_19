<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Menus bound to Sabry website when multi-website is configured -->
    <record id="menu_sabry_home" model="website.menu">
        <field name="name">Home</field>
        <field name="url">/sabry</field>
        <field name="website_id" ref="sabry_developer_website.website_sabry_developer"/>
        <field name="sequence">10</field>
    </record>
    <record id="menu_sabry_cv" model="website.menu">
        <field name="name">CV</field>
        <field name="url">/sabry/cv</field>
        <field name="website_id" ref="sabry_developer_website.website_sabry_developer"/>
        <field name="sequence">20</field>
    </record>
    <record id="menu_sabry_contact" model="website.menu">
        <field name="name">Contact</field>
        <field name="url">/sabry/contact</field>
        <field name="website_id" ref="sabry_developer_website.website_sabry_developer"/>
        <field name="sequence">30</field>
    </record>
</odoo>
