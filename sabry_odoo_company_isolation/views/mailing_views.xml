<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mailing_list_form_company" model="ir.ui.view">
        <field name="name">mailing.list.form.company</field>
        <field name="model">mailing.list</field>
        <field name="inherit_id" ref="mass_mailing.mailing_list_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="company_id" groups="base.group_multi_company"/>
            </xpath>
        </field>
    </record>

    <record id="view_mailing_mailing_form_company" model="ir.ui.view">
        <field name="name">mailing.mailing.form.company</field>
        <field name="model">mailing.mailing</field>
        <field name="inherit_id" ref="mass_mailing.view_mail_mass_mailing_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='email_from']" position="after">
                <field name="company_id" groups="base.group_multi_company"/>
            </xpath>
        </field>
    </record>
</odoo>
