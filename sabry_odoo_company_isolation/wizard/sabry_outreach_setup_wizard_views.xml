<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sabry_outreach_setup_wizard" model="ir.ui.view">
        <field name="name">sabry.outreach.setup.wizard.form</field>
        <field name="model">sabry.outreach.setup.wizard</field>
        <field name="arch" type="xml">
            <form string="Sabry Outreach Setup">
                <group>
                    <field name="state"/>
                    <field name="recipient_count"/>
                    <field name="result_summary" widget="text"/>
                </group>
                <footer>
                    <button name="action_run_full_setup" type="object" string="Run Full Setup" class="btn-primary"/>
                    <button string="Close" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_sabry_outreach_setup_wizard" model="ir.actions.act_window">
        <field name="name">Sabry Outreach Setup</field>
        <field name="res_model">sabry.outreach.setup.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_sabry_outreach_root"
              name="Sabry Outreach"
              parent="mass_mailing.mass_mailing_menu_root"
              sequence="90"/>
    <menuitem id="menu_sabry_outreach_setup"
              name="Run Setup"
              parent="menu_sabry_outreach_root"
              action="action_sabry_outreach_setup_wizard"
              sequence="10"/>
</odoo>
