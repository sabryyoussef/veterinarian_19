<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_product_form_vetution" model="ir.ui.view">
        <field name="name">product.product.form.vetution</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Vetution Size" name="vetution_size">
                    <group>
                        <group>
                            <field name="vetution_size_id"/>
                            <field name="vetution_size_name"/>
                            <field name="vetution_out_of_stock"/>
                            <field name="vetution_expire_date"/>
                        </group>
                        <group>
                            <field name="vetution_image_url" widget="url"/>
                            <field name="vetution_old_price"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
