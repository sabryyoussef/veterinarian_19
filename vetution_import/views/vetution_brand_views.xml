<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vetution_brand_list" model="ir.ui.view">
        <field name="name">vetution.brand.list</field>
        <field name="model">vetution.brand</field>
        <field name="arch" type="xml">
            <list string="Vetution Brands">
                <field name="name"/>
                <field name="slug"/>
                <field name="vetution_id"/>
                <field name="product_count"/>
                <field name="facebook_page" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_vetution_brand_form" model="ir.ui.view">
        <field name="name">vetution.brand.form</field>
        <field name="model">vetution.brand</field>
        <field name="arch" type="xml">
            <form string="Vetution Brand">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-cubes" type="object" name="action_view_products">
                            <field name="product_count" widget="statinfo" string="Products"/>
                        </button>
                    </div>
                    <field name="logo" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Brand name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="slug"/>
                            <field name="vetution_id"/>
                            <field name="logo_url"/>
                            <field name="facebook_page"/>
                        </group>
                        <group>
                            <field name="meta_title"/>
                            <field name="meta_description"/>
                        </group>
                    </group>
                    <group string="Info">
                        <field name="info" nolabel="1" placeholder="Brand info from brands/{slug}"/>
                    </group>
                    <notebook>
                        <page string="Products" name="products">
                            <field name="product_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="vetution_slug"/>
                                    <field name="vetution_id"/>
                                    <field name="list_price"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_vetution_brand_search" model="ir.ui.view">
        <field name="name">vetution.brand.search</field>
        <field name="model">vetution.brand</field>
        <field name="arch" type="xml">
            <search string="Vetution Brands">
                <field name="name"/>
                <field name="slug"/>
                <field name="vetution_id"/>
            </search>
        </field>
    </record>

    <record id="action_vetution_brand" model="ir.actions.act_window">
        <field name="name">Vetution Brands</field>
        <field name="res_model">vetution.brand</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
