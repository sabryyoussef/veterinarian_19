<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vetution_ingredient_list" model="ir.ui.view">
        <field name="name">vetution.ingredient.list</field>
        <field name="model">vetution.ingredient</field>
        <field name="arch" type="xml">
            <list string="Vetution Ingredients">
                <field name="name"/>
                <field name="name_normalized"/>
                <field name="vetution_id"/>
            </list>
        </field>
    </record>

    <record id="view_vetution_ingredient_form" model="ir.ui.view">
        <field name="name">vetution.ingredient.form</field>
        <field name="model">vetution.ingredient</field>
        <field name="arch" type="xml">
            <form string="Vetution Ingredient">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="name_normalized"/>
                        <field name="vetution_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_vetution_ingredient_search" model="ir.ui.view">
        <field name="name">vetution.ingredient.search</field>
        <field name="model">vetution.ingredient</field>
        <field name="arch" type="xml">
            <search string="Vetution Ingredients">
                <field name="name"/>
                <field name="name_normalized"/>
                <field name="vetution_id"/>
            </search>
        </field>
    </record>

    <record id="action_vetution_ingredient" model="ir.actions.act_window">
        <field name="name">Vetution Ingredients</field>
        <field name="res_model">vetution.ingredient</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
