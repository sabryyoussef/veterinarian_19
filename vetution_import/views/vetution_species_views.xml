<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vetution_species_list" model="ir.ui.view">
        <field name="name">vetution.species.list</field>
        <field name="model">vetution.species</field>
        <field name="arch" type="xml">
            <list string="Vetution Species" editable="bottom">
                <field name="name"/>
                <field name="vetution_id"/>
            </list>
        </field>
    </record>

    <record id="view_vetution_species_form" model="ir.ui.view">
        <field name="name">vetution.species.form</field>
        <field name="model">vetution.species</field>
        <field name="arch" type="xml">
            <form string="Vetution Species">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="vetution_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_vetution_species" model="ir.actions.act_window">
        <field name="name">Vetution Species</field>
        <field name="res_model">vetution.species</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
