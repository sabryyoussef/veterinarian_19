<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- All crons created DISABLED (active=False). Do not enable in Phase 1. -->
    <record id="ir_cron_vetution_commercial_refresh" model="ir.cron">
        <field name="name">Vetution: Commercial Refresh</field>
        <field name="model_id" ref="model_vetution_commercial_sync"/>
        <field name="state">code</field>
        <field name="code">model.cron_commercial_refresh()</field>
        <field name="interval_number">2</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="False"/>
    </record>

    <record id="ir_cron_vetution_reconciliation" model="ir.cron">
        <field name="name">Vetution: Nightly Reconciliation</field>
        <field name="model_id" ref="model_vetution_commercial_sync"/>
        <field name="state">code</field>
        <field name="code">model.cron_reconciliation()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="False"/>
    </record>

    <record id="ir_cron_vetution_retry_failed" model="ir.cron">
        <field name="name">Vetution: Retry Failed Items</field>
        <field name="model_id" ref="model_vetution_commercial_sync"/>
        <field name="state">code</field>
        <field name="code">model.cron_retry_failed()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="False"/>
    </record>
</odoo>
