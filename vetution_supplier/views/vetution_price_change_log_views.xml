<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vetution_price_change_log_list" model="ir.ui.view">
        <field name="name">vetution.price.change.log.list</field>
        <field name="model">vetution.price.change.log</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="product_tmpl_id"/>
                <field name="dry_run"/>
                <field name="skipped"/>
                <field name="placeholder_replacement"/>
                <field name="old_list_price"/>
                <field name="new_list_price"/>
                <field name="supplier_cost"/>
                <field name="gross_margin_percent"/>
                <field name="skip_reason"/>
            </list>
        </field>
    </record>

    <record id="view_vetution_price_change_log_form" model="ir.ui.view">
        <field name="name">vetution.price.change.log.form</field>
        <field name="model">vetution.price.change.log</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="connection_id"/>
                        <field name="product_tmpl_id"/>
                        <field name="product_id"/>
                        <field name="offer_id"/>
                        <field name="dry_run"/>
                        <field name="skipped"/>
                        <field name="skip_reason"/>
                        <field name="placeholder_replacement"/>
                    </group>
                    <group string="Prices">
                        <field name="old_list_price"/>
                        <field name="new_list_price"/>
                        <field name="supplier_cost"/>
                        <field name="markup_price"/>
                        <field name="minimum_margin_price"/>
                        <field name="minimum_profit_price"/>
                        <field name="candidate"/>
                        <field name="gross_profit"/>
                        <field name="gross_margin_percent"/>
                    </group>
                    <group string="Policy">
                        <field name="markup_percent"/>
                        <field name="min_margin_percent"/>
                        <field name="min_profit_amount"/>
                        <field name="rounding"/>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_vetution_price_change_log" model="ir.actions.act_window">
        <field name="name">Price Change Logs</field>
        <field name="res_model">vetution.price.change.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
