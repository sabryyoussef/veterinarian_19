<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vetution_pricing_activation_wizard_form" model="ir.ui.view">
        <field name="name">vetution.pricing.activation.wizard.form</field>
        <field name="model">vetution.pricing.activation.wizard</field>
        <field name="arch" type="xml">
            <form string="Pricing Activation Pilot">
                <group>
                    <field name="connection_id"/>
                    <field name="dry_run"/>
                    <field name="confirm_write"/>
                    <field name="limit"/>
                    <field name="template_ids" widget="many2many_tags"/>
                </group>
                <group>
                    <field name="result_message"/>
                    <field name="log_count"/>
                </group>
                <footer>
                    <button name="action_select_pilot" type="object" string="Auto-select ≤50" class="btn-secondary"/>
                    <button name="action_run" type="object" string="Run Pilot" class="btn-primary"/>
                    <button name="action_open_logs" type="object" string="Open Logs"/>
                    <button string="Close" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_vetution_pricing_activation_wizard" model="ir.actions.act_window">
        <field name="name">Pricing Activation Pilot</field>
        <field name="res_model">vetution.pricing.activation.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
