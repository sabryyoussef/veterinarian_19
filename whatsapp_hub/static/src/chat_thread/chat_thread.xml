<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="whatsapp_hub.ConversationChat">
        <div class="o_wa_chat_root d-flex flex-column h-100">
            <div class="o_wa_chat_header border-bottom px-3 py-2 d-flex flex-wrap align-items-center gap-2">
                <div class="flex-grow-1 min-w-0">
                    <div class="fw-bold text-truncate" t-esc="state.conversationName"/>
                    <div class="small text-muted text-truncate">
                        <t t-if="state.groupName" t-esc="state.groupName"/>
                        <t t-elif="state.remoteJid" t-esc="state.remoteJid"/>
                        <t t-esc="' · ' + state.total + ' messages'"/>
                    </div>
                </div>
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <div class="form-check form-switch mb-0">
                        <input class="form-check-input" type="checkbox"
                               id="waHideNoise"
                               t-att-checked="state.hideNoise"
                               t-on-change="onToggleHideNoise"/>
                        <label class="form-check-label small" for="waHideNoise">Hide noise</label>
                    </div>
                    <div class="form-check form-switch mb-0">
                        <input class="form-check-input" type="checkbox"
                               id="waShowHidden"
                               t-att-checked="state.showHidden"
                               t-on-change="onToggleShowHidden"/>
                        <label class="form-check-label small" for="waShowHidden">Show hidden</label>
                    </div>
                    <select class="form-select form-select-sm w-auto"
                            t-on-change="onMediaFilterChange">
                        <option value="all" t-att-selected="state.mediaFilter === 'all'">All</option>
                        <option value="text" t-att-selected="state.mediaFilter === 'text'">Text only</option>
                        <option value="media" t-att-selected="state.mediaFilter === 'media'">Has media</option>
                    </select>
                    <button class="btn btn-sm btn-secondary" t-on-click="openConversationForm">Details</button>
                </div>
            </div>

            <div t-if="state.loading" class="p-4 text-muted">Loading conversation…</div>
            <div t-elif="state.error" class="alert alert-danger m-3" t-esc="state.error"/>

            <div t-else="" class="o_wa_chat_thread flex-grow-1 overflow-auto px-3 py-3" t-ref="thread">
                <div class="text-center mb-3" t-if="state.hasOlder">
                    <button class="btn btn-sm btn-link"
                            t-att-disabled="state.loadingOlder"
                            t-on-click="loadOlder">
                        <t t-if="state.loadingOlder">Loading…</t>
                        <t t-else="">Load older messages</t>
                    </button>
                </div>
                <div t-if="!state.messages.length" class="text-muted text-center py-5">
                    No messages match the current filters.
                </div>
                <t t-foreach="state.messages" t-as="msg" t-key="msg.id">
                    <div t-att-class="bubbleClass(msg, msg_index)"
                         t-att-data-message-id="msg.id">
                        <div t-if="showSender(msg, msg_index)" class="o_wa_sender small fw-semibold mb-1"
                             t-esc="msg.sender"/>
                        <div class="o_wa_bubble_body">
                            <t t-if="msg.media_kind and msg.media_kind !== 'none'">
                                <span class="badge o_wa_media_chip me-1 mb-1">
                                    <i t-att-class="'fa ' + mediaIcon(msg.media_kind) + ' me-1'"/>
                                    <t t-esc="msg.media_kind"/>
                                </span>
                            </t>
                            <t t-if="msg.preview_url and isImage(msg)">
                                <div class="o_wa_media_preview mb-1">
                                    <img t-att-src="msg.preview_url" alt="media" class="o_wa_media_img"/>
                                </div>
                            </t>
                            <t t-elif="msg.preview_url and isAudio(msg)">
                                <audio controls="controls" class="o_wa_media_audio w-100 mb-1"
                                       t-att-src="msg.preview_url"/>
                            </t>
                            <t t-elif="msg.preview_url and isVideo(msg)">
                                <video controls="controls" class="o_wa_media_video w-100 mb-1"
                                       t-att-src="msg.preview_url"/>
                            </t>
                            <t t-elif="msg.preview_url">
                                <a class="d-inline-block mb-1" t-att-href="msg.preview_url" target="_blank">
                                    Open attachment
                                </a>
                            </t>
                            <t t-elif="msg.can_fetch_media">
                                <button class="btn btn-sm btn-outline-primary mb-1"
                                        t-att-disabled="state.fetchingMediaId === msg.id"
                                        t-on-click="() => this.fetchMedia(msg)">
                                    <t t-if="state.fetchingMediaId === msg.id">Fetching…</t>
                                    <t t-else="">Load media preview</t>
                                </button>
                            </t>
                            <div t-if="msg.body" class="o_wa_text text-break" t-esc="msg.body"/>
                        </div>
                        <div class="o_wa_meta d-flex align-items-center gap-2 mt-1">
                            <span class="small text-muted" t-esc="formatTime(msg.timestamp)"/>
                            <button class="btn btn-link btn-sm p-0" t-on-click="() => this.hideMessage(msg)">Hide</button>
                            <button class="btn btn-link btn-sm p-0" t-on-click="() => this.openMessageForm(msg)">Open</button>
                        </div>
                    </div>
                </t>
            </div>
        </div>
    </t>
</templates>
