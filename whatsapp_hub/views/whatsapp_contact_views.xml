<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_whatsapp_contact_list" model="ir.ui.view">
        <field name="name">whatsapp.contact.list</field>
        <field name="model">whatsapp.contact</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="jid"/>
                <field name="phone_e164"/>
                <field name="partner_id"/>
            </list>
        </field>
    </record>
    <record id="view_whatsapp_contact_form" model="ir.ui.view">
        <field name="name">whatsapp.contact.form</field>
        <field name="model">whatsapp.contact</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="jid"/>
                        <field name="phone_e164"/>
                        <field name="partner_id"/>
                        <field name="push_name"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_whatsapp_contact" model="ir.actions.act_window">
        <field name="name">WhatsApp Contacts</field>
        <field name="res_model">whatsapp.contact</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
