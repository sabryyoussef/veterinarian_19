<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_whatsapp_conversation_list" model="ir.ui.view">
        <field name="name">whatsapp.conversation.list</field>
        <field name="model">whatsapp.conversation</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="conversation_type"/>
                <field name="purpose"/>
                <field name="remote_jid"/>
                <field name="instance_reference"/>
                <field name="group_id"/>
                <field name="contact_id"/>
                <field name="partner_id"/>
                <field name="chatwoot_conversation_id"/>
                <field name="last_message_at"/>
            </list>
        </field>
    </record>
    <record id="view_whatsapp_conversation_form" model="ir.ui.view">
        <field name="name">whatsapp.conversation.form</field>
        <field name="model">whatsapp.conversation</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_chat" type="object" string="Chat"
                            class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="conversation_type"/>
                        <field name="purpose"/>
                        <field name="remote_jid"/>
                        <field name="identity_key"/>
                        <field name="instance_id"/>
                        <field name="instance_reference"/>
                        <field name="group_id"/>
                        <field name="contact_id"/>
                        <field name="partner_id"/>
                        <field name="chatwoot_account_id"/>
                        <field name="chatwoot_inbox_id"/>
                        <field name="chatwoot_conversation_id"/>
                        <field name="last_message_at"/>
                    </group>
                    <notebook>
                        <page string="Messages">
                            <field name="message_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_whatsapp_conversation" model="ir.actions.act_window">
        <field name="name">Conversations</field>
        <field name="res_model">whatsapp.conversation</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_whatsapp_conversation_chat" model="ir.actions.client">
        <field name="name">Conversation Chat</field>
        <field name="tag">whatsapp_hub_conversation_chat</field>
        <field name="target">current</field>
    </record>
</odoo>
