<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_whatsapp_discuss_shadow_list" model="ir.ui.view">
        <field name="name">whatsapp.discuss.shadow.list</field>
        <field name="model">whatsapp.discuss.shadow</field>
        <field name="arch" type="xml">
            <list>
                <field name="create_date"/>
                <field name="name"/>
                <field name="classification"/>
                <field name="eligible"/>
                <field name="channel_id"/>
                <field name="mail_message_id"/>
                <field name="partner_id"/>
                <field name="wa_message_log_id"/>
                <field name="mirrored_message_id"/>
                <field name="candidate_business_key"/>
                <field name="actual_business_key"/>
            </list>
        </field>
    </record>
    <record id="view_whatsapp_discuss_shadow_form" model="ir.ui.view">
        <field name="name">whatsapp.discuss.shadow.form</field>
        <field name="model">whatsapp.discuss.shadow</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="classification"/>
                        <field name="eligible"/>
                        <field name="mismatch_reason"/>
                    </group>
                    <group string="Discuss source">
                        <field name="channel_id"/>
                        <field name="mail_message_id"/>
                        <field name="partner_id"/>
                        <field name="wa_message_log_id"/>
                        <field name="mirrored_message_id"/>
                    </group>
                    <group string="Candidate vs actual">
                        <field name="candidate_business_key"/>
                        <field name="actual_business_key"/>
                        <field name="candidate_destination"/>
                        <field name="actual_remote_jid"/>
                        <field name="candidate_purpose"/>
                        <field name="actual_purpose"/>
                        <field name="candidate_instance_reference"/>
                        <field name="actual_instance_reference"/>
                        <field name="expected_conversation_identity_key"/>
                        <field name="actual_conversation_identity_key"/>
                        <field name="actual_conversation_id"/>
                    </group>
                    <group string="Evidence">
                        <field name="preview_payload" widget="text"/>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_whatsapp_discuss_shadow" model="ir.actions.act_window">
        <field name="name">Discuss Shadow Reports</field>
        <field name="res_model">whatsapp.discuss.shadow</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
