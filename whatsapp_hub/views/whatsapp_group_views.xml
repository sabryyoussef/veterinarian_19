<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_whatsapp_group_list" model="ir.ui.view">
        <field name="name">whatsapp.group.list</field>
        <field name="model">whatsapp.group</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="jid"/>
                <field name="chatwoot_inbox_id"/>
                <field name="chatwoot_label"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_whatsapp_group_form" model="ir.ui.view">
        <field name="name">whatsapp.group.form</field>
        <field name="model">whatsapp.group</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="jid"/>
                        <field name="chatwoot_inbox_id"/>
                        <field name="chatwoot_label"/>
                        <field name="instance_id"/>
                        <field name="active"/>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_whatsapp_group" model="ir.actions.act_window">
        <field name="name">WhatsApp Groups</field>
        <field name="res_model">whatsapp.group</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
