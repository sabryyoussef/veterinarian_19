<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_whatsapp_instance_list" model="ir.ui.view">
        <field name="name">whatsapp.instance.list</field>
        <field name="model">whatsapp.instance</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="instance_name"/>
                <field name="purpose"/>
                <field name="api_url"/>
                <field name="is_default"/>
                <field name="unified_outbound_enabled"/>
                <field name="discuss_cutover_enabled"/>
                <field name="campaign_cutover_enabled"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_whatsapp_instance_form" model="ir.ui.view">
        <field name="name">whatsapp.instance.form</field>
        <field name="model">whatsapp.instance</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="instance_name"/>
                        <field name="purpose"/>
                        <field name="api_url"/>
                        <field name="is_default"/>
                        <field name="unified_outbound_enabled"/>
                        <field name="discuss_cutover_enabled"/>
                <field name="campaign_cutover_enabled"/>
                        <field name="web_url"/>
                        <field name="active"/>
                        <field name="evolution_instance_id" groups="base.group_no_one"/>
                        <field name="api_key" password="True"
                                 groups="whatsapp_hub.group_whatsapp_manager"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_whatsapp_instance" model="ir.actions.act_window">
        <field name="name">WhatsApp Instances</field>
        <field name="res_model">whatsapp.instance</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
